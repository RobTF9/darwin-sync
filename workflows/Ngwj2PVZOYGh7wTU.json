{
  "id": "Ngwj2PVZOYGh7wTU",
  "name": "ScheduledSessions",
  "description": "Sub-workflow tool for Darwin and Galapagos: scheduled research sessions from calendar_research_sessions. Parameterized query (replaces the inline get_scheduled_sessions Postgres tool). DWN-81.",
  "nodes": [
    {
      "id": "f707c095-211b-47eb-a9a5-2008e5849202",
      "name": "Sub",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "session_type"
            },
            {
              "name": "start_date"
            },
            {
              "name": "end_date"
            },
            {
              "name": "include_canceled"
            }
          ]
        }
      }
    },
    {
      "id": "71c781af-97a5-4b27-9c86-d6064f6a7283",
      "name": "Get Scheduled Sessions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT session_type, organizer_name, organizer_email, title, starts_at, canceled_at\nFROM calendar_research_sessions\nWHERE (NULLIF($1::text, '') IS NULL OR session_type = $1::text)\n  AND (NULLIF($2::text, '') IS NOT NULL OR canceled_at IS NULL)\n  AND starts_at::date BETWEEN\n    COALESCE(NULLIF($3::text, '')::date, CURRENT_DATE)\n    AND COALESCE(NULLIF($4::text, '')::date, COALESCE(NULLIF($3::text, '')::date, CURRENT_DATE))\nORDER BY starts_at ASC;",
        "options": {
          "queryReplacement": "={{ [String($json.session_type ?? '').trim(), String($json.include_canceled ?? '').trim(), String($json.start_date ?? '').trim(), String($json.end_date ?? '').trim()] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "1d2f2fdb-fc09-4c31-932c-2253e54ed97a",
      "name": "Shape Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().filter(i => i.json && i.json.starts_at);\nif (rows.length) return rows;\nreturn [{ json: { message: 'No scheduled sessions match these filters.' } }];"
      }
    }
  ],
  "connections": {
    "Sub": {
      "main": [
        [
          {
            "node": "Get Scheduled Sessions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Scheduled Sessions": {
      "main": [
        [
          {
            "node": "Shape Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
