      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = $input.first().json;\nconst keys = Object.keys(out);\nconst shapes = {};\nfor (const k of keys) {\n  const v = out[k];\n  if (Array.isArray(v)) { shapes[k] = 'array(' + v.length + ')'; }\n  else if (v !== null && typeof v === 'object') { shapes[k] = 'object(' + Object.keys(v).join(',') + ')'; }\n  else { shapes[k] = typeof v + ':' + String(v).slice(0, 200); }\n}\nreturn [{ json: { shapeSummary: shapes, full: out } }];"
      }
    }
