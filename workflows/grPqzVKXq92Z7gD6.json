    {
      "id": "0a2e1c41-5f3d-4990-b784-b212766bbda9",
      "name": "Filter & Group By User",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Filter messages that share research calls, then group by posting user.\n// Upper time bound enforced here (Slack 'latest' filter is unreliable with returnAll).\nconst KEYWORDS = ['gong.io/call', 'us-29262.app.gong.io', 'pidgeonhead', 'research call', 'session'];\nconst OLDEST = 1755475200; // 2025-08-18 00:00 UTC\nconst LATEST = 1787011200; // 2026-08-18 00:00 UTC\n\nconst items = $input.all();\nconst counts = {}; // userId -> count\n\nfor (const it of items) {\n  const m = it.json || {};\n  if (m.bot_id) continue;\n  const user = m.user;\n  if (!user) continue;\n  const ts = parseFloat(m.ts);\n  if (!isNaN(ts) && (ts < OLDEST || ts >= LATEST)) continue;\n  const text = (m.text || '').toLowerCase();\n  if (!text) continue;\n  const matched = KEYWORDS.some(k => text.includes(k));\n  if (!matched) continue;\n  counts[user] = (counts[user] || 0) + 1;\n}\n\nconst total = Object.values(counts).reduce((a, b) => a + b, 0);\nconst userIds = Object.keys(counts);\nif (userIds.length === 0) {\n  return [{ json: { userId: null, count: 0, total: 0, noData: true } }];\n}\nreturn userIds.map(uid => ({ json: { userId: uid, count: counts[uid], total } }));"
      }
    },
    {
      "id": "62af5404-c4c4-42c9-b6fa-6c48d49a02fa",
      "name": "Build Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.userId);\nconst total = rows.reduce((a, r) => a + (Number(r.count) || 0), 0);\n\nif (rows.length === 0 || total === 0) {\n  return [{ json: { report: 'No research-call-sharing messages found in channel C035KDLD6MP for the period 2025-08-18 to 2026-08-18.' } }];\n}\n\nrows.sort((a, b) => (Number(b.count) || 0) - (Number(a.count) || 0));\n\nlet table = '*Research Call Share Distribution — <#C035KDLD6MP>*\\n';\ntable += '_Period: 2025-08-18 → 2026-08-18 · Total research-call shares: ' + total + '_\\n\\n';\ntable += '```\\n';\nconst pad = (s, n) => (String(s) + ' '.repeat(n)).slice(0, n);\ntable += pad('Person Name', 28) + pad('Message Count', 15) + 'Percentage (%)\\n';\ntable += '-'.repeat(58) + '\\n';\nfor (const r of rows) {\n  const cnt = Number(r.count) || 0;\n  const pct = (cnt / total * 100).toFixed(1);\n  table += pad(r.name, 28) + pad(cnt, 15) + pct + '%\\n';\n}\ntable += '-'.repeat(58) + '\\n';\ntable += pad('TOTAL', 28) + pad(total, 15) + '100.0%\\n';\ntable += '```';\n\nreturn [{ json: { report: table, total } }];"
      }
    },
