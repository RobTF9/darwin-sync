        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const counts = {};\nfor (const item of items) {\n  const user = item.json.user || item.json.username || item.json.bot_id || 'unknown';\n  counts[user] = (counts[user] || 0) + 1;\n}\nconst total = Object.values(counts).reduce((a, b) => a + b, 0);\nreturn Object.entries(counts)\n  .sort((a, b) => b[1] - a[1])\n  .map(([user, count]) => ({ json: { user, count, percentage: total ? Math.round((count / total) * 10000) / 100 : 0, total } }));"
