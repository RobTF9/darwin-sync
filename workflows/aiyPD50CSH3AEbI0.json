    {
      "parameters": {
        "jsCode": "// Words (Deepgram transcript_object) → timestamped sentence lines → chunks.\n// One line per sentence: \"S<speaker> [start]: text\" — [start] is the exact audio\n// time of the line's first word. Lines break at sentence ends, speaker changes,\n// and silences > SILENCE_GAP. Lines pack into chunks of ~CHUNK_TOKENS estimated\n// tokens with OVERLAP_TOKENS overlap, hard-capped at MAX_CHUNK_CHARS so the\n// vector store never needs to re-split (which would corrupt start/end metadata).\nconst sessionId = $('sub_trigger').item.json.session_id;\nlet words = $('sub_trigger').item.json.words ?? [];\n// Defensive: callers that stringify the array (e.g. convertFieldsToString) still work\nif (typeof words === 'string') {\n  try { words = JSON.parse(words); } catch { words = []; }\n}\nif (!Array.isArray(words)) words = [];\n\nconst CHUNK_TOKENS = 1000;\nconst OVERLAP_TOKENS = 100;\nconst MAX_CHUNK_CHARS = 9000;\nconst SILENCE_GAP = 3; // seconds\n\nconst estimateTokens = (text) => Math.ceil(text.length / 4);\n\n// 1. words → sentence lines\nconst sentences = [];\nlet line = null;\nlet prevEnd = null;\n\nconst flush = () => {\n  if (line && line.words.length) {\n    sentences.push({\n      line: `S${line.speaker} [${line.start.toFixed(2)}]: ${line.words.join(' ')}`,\n      start: line.start,\n      end: line.end,\n      speaker: line.speaker,\n    });\n  }\n  line = null;\n};\n\nfor (const w of words) {\n  const text = w.punctuated_word ?? w.word;\n  const speaker = w.speaker ?? '?';\n  const breaksLine =\n    (line && speaker !== line.speaker) ||\n    (prevEnd !== null && w.start - prevEnd > SILENCE_GAP);\n\n  if (breaksLine) flush();\n  if (!line) line = { speaker, start: w.start, words: [], end: w.end };\n\n  line.words.push(text);\n  line.end = w.end;\n  prevEnd = w.end;\n\n  if (/[.!?][\"')\\]]*$/.test(text)) flush();\n}\nflush();\n\n// 2. pack sentence lines into chunks\nconst chunks = [];\nlet i = 0;\n\nwhile (i < sentences.length) {\n  let tokens = 0;\n  let chars = 0;\n  let j = i;\n\n  while (\n    j < sentences.length &&\n    tokens + estimateTokens(sentences[j].line) <= CHUNK_TOKENS &&\n    chars + sentences[j].line.length <= MAX_CHUNK_CHARS\n  ) {\n    tokens += estimateTokens(sentences[j].line);\n    chars += sentences[j].line.length;\n    j++;\n  }\n  if (j === i) j = i + 1; // a single oversized sentence still progresses\n\n  const win = sentences.slice(i, j);\n\n  chunks.push({\n    json: {\n      session_id: sessionId,\n      index: chunks.length,\n      text: win.map(s => s.line).join('\\n'),\n      start: win[0].start,\n      end: win[win.length - 1].end,\n      speakers: [...new Set(win.map(s => s.speaker))],\n      duration_seconds: Math.round((win[win.length - 1].end - win[0].start) * 100) / 100,\n      token_estimate: tokens,\n    }\n  });\n\n  if (j >= sentences.length) break; // final chunk emitted — no trailing overlap-only chunks\n\n  let overlap = 0;\n  let next = j;\n  while (next > i + 1 && overlap < OVERLAP_TOKENS) {\n    next--;\n    overlap += estimateTokens(sentences[next].line);\n  }\n\n  i = Math.max(next, i + 1);\n}\n\nreturn chunks;"
      },
