    {
      "parameters": {
        "jsCode": "const param = $('Normalize Input').item.json;\nconst caseRow = $('Load Case').first().json;\nconst ec = caseRow.eval_config || {};\nconst runs = Math.min(Math.max(parseInt(String(param.runs), 10) || 1, 1), 20);\nconst base = String(param.parent_run_id || ('eval-' + $execution.id));\nconst items = [];\nfor (let i = 0; i < runs; i++) {\n  items.push({ json: { run_id: base + '-' + i, case_id: caseRow.case_id || '', test_case_id: caseRow.id || '', env: 'slack', input: (caseRow.inputs && caseRow.inputs.prompt) || '', context_messages: ec.context_messages || '[]', prohibited_tools: ec.prohibited_tools || '[]', ground_truth: ec.expected_response || '', rubric: '' } });\n}\nreturn items;"
