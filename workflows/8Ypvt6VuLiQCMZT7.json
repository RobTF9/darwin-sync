    {
      "parameters": {
        "jsCode": "var j = $input.first().json;\nvar channelId = (j.channel_id || '').toString().trim();\nvar threadTs = (j.thread_ts || '').toString().trim();\nvar userId = (j.user_id || '').toString().trim();\nvar tsOk = /^\\d+\\.\\d+$/.test(threadTs);\nif (!channelId || !tsOk) {\n  return [{ json: { valid: false, error: 'Missing or invalid Slack context (channel_id=' + (channelId || 'empty') + ', thread_ts=' + (threadTs || 'empty') + '). Tell the user something went wrong and the recruiting wizard did not start.' } }];\n}\nreturn [{ json: { valid: true, session_key: channelId + '_' + threadTs, channel_id: channelId, thread_ts: threadTs, user_id: userId, now: new Date().toISOString() } }];",
        "mode": "runOnceForAllItems",
        "language": "javaScript"
      },
      "id": "65e52e89-b6ba-4a2f-a8a2-239beaa74680",
      "name": "Validate Input",
