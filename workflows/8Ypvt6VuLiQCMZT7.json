        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $('Validate Input').item.json.channel_id, thread_ts: $('Validate Input').item.json.thread_ts, text: \"Recruiting Wizard: who do you want to talk to? Options: n8n Users, Non-users, Cancel.\", blocks: [ { type: \"section\", text: { type: \"mrkdwn\", text: \":mag: *Recruiting Wizard*\\n\\nLet's find participants for your research. First, who do you want to talk to?\" } }, { type: \"actions\", elements: [ { type: \"button\", text: { type: \"plain_text\", text: \"n8n Users\", emoji: true }, style: \"primary\", action_id: \"uxr_audience_n8n_users\", value: \"n8n_users\" }, { type: \"button\", text: { type: \"plain_text\", text: \"Non-users\", emoji: true }, action_id: \"uxr_audience_non_users\", value: \"non_users\" }, { type: \"button\", text: { type: \"plain_text\", text: \"Cancel\", emoji: true }, style: \"danger\", action_id: \"uxr_cancel\", value: \"cancel\" } ] } ] }) }}",
        "options": {}
      },
