    {
      "id": "cc20e7f1-cc7d-4276-ab96-2b88410dcf67",
      "name": "Thread Free?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        32
      ],
      "parameters": {
        "jsCode": "// One recruiting per Slack thread, strictly: if this thread ever started a recruiting (any state, any age), no new one starts here.\n// Simple rule for the user (\"new recruiting = new thread\") and no ambiguity about which campaign a thread belongs to.\nconst v = $('Validate Input').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.session_key);\nconst row = rows[0] || null;\nconst blocked = !!row;\nlet block_message = '';\nif (blocked) {\n  const state = String(row.state || 'unknown');\n  const invited = Number(row.requested_count) || 0;\n  const booked = Number(row.booked_count) || 0;\n  let label = 'in progress, step: ' + state;\n  if (state === 'complete') label = 'complete, ' + invited + ' invited, ' + booked + ' booked';\n  else if (state === 'sending') label = 'sending emails right now';\n  else if (state === 'cancelled') label = 'cancelled';\n  block_message = 'This thread already has a recruiting (' + label + '). The rule is one recruiting per Slack thread, so the wizard cannot start here again. Tell the user to start a new thread for a new recruiting' + (state === 'complete' || state === 'sending' || state === 'cancelled' ? '.' : ', or to continue this one with the cards above.') + ' Do not start the wizard here.';\n}\nreturn [{ json: { ...v, blocked, block_message } }];"
      }
    },
