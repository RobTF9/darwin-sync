      "id": "dad3b9ed-3750-4d37-acce-528f6b74eac5",
      "name": "Load Config",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1792,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "const v = $('Validate Input').first().json;\nconst config = $input.first().json || {};\nconst audiences = Array.isArray(config.audiences) && config.audiences.length ? config.audiences : [\n  { id: 'n8n_users', label: 'n8n users', emoji: ':busts_in_silhouette:', description: 'People with an n8n cloud account from Customer.io.' },\n  { id: 'volunteers', label: 'Research volunteers', emoji: ':raising_hand:', description: 'People who signed up through the research webform. Includes non-users.' }\n];\nconst blocks = [\n  { type: 'section', text: { type: 'mrkdwn', text: \":mag: *Recruiting Wizard*\\n\\nWho do you want to talk to?\" } },\n  { type: 'divider' }\n];\nfor (const a of audiences) {\n  blocks.push({ type: 'section', text: { type: 'mrkdwn', text: (a.emoji ? a.emoji + ' ' : '') + '*' + a.label + '*' + (a.pool ? '  ·  _' + a.pool + '_' : '') + '\\n' + (a.description || '') }, accessory: { type: 'button', text: { type: 'plain_text', text: 'Choose', emoji: true }, style: 'primary', action_id: 'uxr_audience_' + a.id, value: a.id } });\n}\nreturn [{ json: { channel_id: v.channel_id, thread_ts: v.thread_ts, blocks: JSON.stringify(blocks) } }];"
      },
