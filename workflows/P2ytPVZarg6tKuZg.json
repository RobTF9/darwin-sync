      "id": "8d58701c-09b8-42c9-99d7-834ad21b8ccb",
      "name": "Get Active Employees (Daily)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2384,
        352
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "9qOBTlGp0nmv5Nbn",
          "name": "Aniol's n8n directory"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst groups = {};\nfor (const item of items) {\n  const uid = item.json.eventICalUID || (item.json.eventTitle + '|' + item.json.eventStart);\n  const isOrganizer = !!item.json.colleagueEmail && !!item.json.organizerEmail &&\n    item.json.colleagueEmail.toLowerCase() === item.json.organizerEmail.toLowerCase();\n  const candidate = { ...item.json, externalId: uid, _isOrganizer: isOrganizer };\n  const existing = groups[uid];\n  if (!existing || (isOrganizer && !existing._isOrganizer)) {\n    groups[uid] = candidate;\n  }\n}\nreturn Object.values(groups).map(g => {\n  const { _isOrganizer, ...json } = g;\n  return { json };\n});"
      },
      "id": "2e9a8365-0f1d-4d72-9e21-3cc21269a263",
      "name": "Dedupe by iCalUID (Organizer Only)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3728,
        352
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO calendar_research_sessions\n  (session_type, source, external_id, organizer_name, organizer_email, title, description, starts_at, updated_at)\nVALUES\n  ('research', 'calendar_scan', $1, $2, $3, $4, $5, $6, now())\nON CONFLICT (session_type, external_id) DO UPDATE SET\n  organizer_name = EXCLUDED.organizer_name,\n  organizer_email = EXCLUDED.organizer_email,\n  title = EXCLUDED.title,\n  description = EXCLUDED.description,\n  starts_at = EXCLUDED.starts_at,\n  updated_at = now();",
        "options": {
          "queryReplacement": "={{ [$json.externalId, $json.organizerName, $json.organizerEmail, $json.eventTitle, $json.eventDescription, $json.eventStart] }}"
        }
      },
      "id": "53e2987d-177e-47cf-8073-39e73823f3ac",
      "name": "Upsert Research Session",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        3952,
        352
      ],
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  $1::text AS \"colleagueName\",\n  $2::text AS \"colleagueEmail\",\n  $3::text AS \"eventTitle\",\n  $4::text AS \"eventStart\",\n  $5::text AS \"eventDescription\",\n  $6::text AS \"eventICalUID\",\n  $7::text AS \"organizerEmail\",\n  $8::text AS \"organizerName\"\nWHERE NOT EXISTS (\n  SELECT 1 FROM calendar_research_sessions\n  WHERE session_type = 'continuous_discovery'\n    AND canceled_at IS NULL\n    AND organizer_email = $7\n    AND starts_at BETWEEN $4::timestamptz - interval '2 minutes' AND $4::timestamptz + interval '2 minutes'\n);",
        "options": {
          "queryReplacement": "={{ [$json.colleagueName, $json.colleagueEmail, $json.eventTitle, $json.eventStart, $json.eventDescription, $json.eventICalUID, $json.organizerEmail, $json.organizerName] }}"
        }
      },
      "id": "abe2508d-dd72-4f51-8cc6-711ff107b797",
      "name": "Check Not Continuous Discovery",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        3504,
        352
      ],
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      },
      "notes": "Excludes an event iff a matching continuous_discovery row already exists (same organizer_email + starts_at, from the Calendly webhook/backfill) -- replaces the old hardcoded-description-text exclusion. Echoes back the 8 original fields via SELECT AS so Dedupe/Upsert downstream don't need to change."
    }
  ],
