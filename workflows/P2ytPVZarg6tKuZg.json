      "id": "5195fd2b-6eac-4492-aa54-476891ba4492",
      "name": "Match Research Sessions (Daily)",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        3280,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json; const people = resp.people || []; const results = []; for (const p of people) { const orgs = p.organizations || []; if (orgs.length === 0) { continue; } const email = (p.emailAddresses && p.emailAddresses[0] && p.emailAddresses[0].value) || ''; const name = (p.names && p.names[0] && p.names[0].displayName) || ''; if (email) { results.push({ json: { name: name, email: email } }); } } return results;"
      },
      "id": "c3c52069-4b13-4a81-9372-8aa6861f5a01",
      "name": "Normalize Employee Info (Daily)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2608,
        352
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "url": "https://people.googleapis.com/v1/people:listDirectoryPeople",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "readMask",
              "value": "names,emailAddresses,organizations"
            },
            {
              "name": "sources",
              "value": "DIRECTORY_SOURCE_TYPE_DOMAIN_PROFILE"
