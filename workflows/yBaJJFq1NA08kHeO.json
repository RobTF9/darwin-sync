          "mode": "id",
          "value": "9aoqb4qULHyuLs1K"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
