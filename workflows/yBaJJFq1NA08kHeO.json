      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const raw = String($json.chatInput || '').trim();\nlet slug = '';\nlet category = '';\nif (raw.startsWith('{')) {\n  try {\n    const p = JSON.parse(raw);\n    slug = String(p.slug || '');\n    category = String(p.category || '');\n  } catch (e) { slug = raw; }\n} else if (raw && raw !== 'all') {\n  slug = raw;\n}\nreturn [{ json: { slug, category } }];"
      }
    },
    {
      "id": "7fe1e4bf-44dd-4e14-855c-c0537fae2e36",
      "name": "Run Retrieval Suite",
      "type": "n8n-nodes-base.executeWorkflow",
