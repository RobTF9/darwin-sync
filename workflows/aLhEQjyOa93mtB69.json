      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $json;\nlet inputs = {}; let assertions = [];\nif (typeof c.inputs === 'object') { inputs = c.inputs; } else { try { inputs = JSON.parse(c.inputs || '{}'); } catch (e) { inputs = {}; } }\nif (Array.isArray(c.assertions)) { assertions = c.assertions; } else { try { assertions = JSON.parse(c.assertions || '[]'); } catch (e) { assertions = []; } }\nreturn { json: { run_id: c.run_id || '', test_case_id: c.id || c.test_case_id || '', case_id: c.case_id, target: c.target, description: c.description || '', inputs, assertions } };"
      }
    },
