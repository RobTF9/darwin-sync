    {
      "id": "ab93be2d-eee9-4a45-b3ca-c7b7c838b9cc",
      "name": "Evaluate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3808,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const runStart = Date.parse($('Init Run Context').first().json.runStartedAt) - 15000;\nconst slackExecs = $('Slack Error Executions').all().map(i => i.json);\nconst globalExecs = $('Global Error Executions').all().map(i => i.json);\nconst replies = $('Read Thread Replies').all().map(i => i.json.text || '').join(' || ');\nconst reactionsJson = $('Read Target Reactions').first().json;\nconst reactions = ((reactionsJson.message && reactionsJson.message.reactions) || []).map(r => r.name);\nconst ran = (list) => list.some(e => e.startedAt && Date.parse(e.startedAt) >= runStart);\nconst checks = [\n  { name: 'slack_error_handler_ran', pass: ran(slackExecs) },\n  { name: 'global_error_handler_ran', pass: ran(globalExecs) },\n  { name: 'slack_error_reply_posted', pass: replies.indexOf('Sorry — this execution failed') !== -1 },\n  { name: 'global_error_reply_posted', pass: replies.indexOf('Execution failed:') !== -1 },\n  { name: 'x_reaction_added', pass: reactions.indexOf('x') !== -1 },\n  { name: 'loading_reaction_removed', pass: reactions.indexOf('loading') === -1 }\n];\nconst passed = checks.filter(c => c.pass).length;\nconst lines = checks.map(c => (c.pass ? '✅' : '❌') + ' ' + c.name);\nconst postText = '🧪 Chaos harness results: ' + passed + '/' + checks.length + ' passed' + String.fromCharCode(10) + lines.join(String.fromCharCode(10));\nreturn [{ json: { passed, failed: checks.length - passed, total: checks.length, ok: passed === checks.length, checks, summary: lines.join(' | '), postText } }];"
      }
    },
