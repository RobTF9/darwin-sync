  "name": "SlackThreadIngestion",
  "nodes": [
    {
      "parameters": {
        "jsCode": "\n\n// Resolve the channel ID for this thread dynamically from upstream data\nconst channelId = $('GetChannel').item.json.channel || $('Channels').first().json.channel;\n\n// Get all thread messages and corresponding user profiles\nconst threadMessages = $('GetThread').all();\nconst userProfiles = $('GetUser').all();\n\n// Build a map of user id -> profile for reliable lookup (order-independent)\nconst profileMap = {};\nfor (const p of userProfiles) {\n  const prof = p.json || {};\n  const uid = prof.id || prof.user;\n  if (uid) profileMap[uid] = prof;\n}\n\n// Format each message with username, looked up by the message's author id\nconst formattedThread = threadMessages.map((msg) => {\n  const profile = profileMap[msg.json.user];\n  const userName = profile?.real_name || msg.json.user;\n  const userTitle = profile?.title || '';\n\n  return `<message>\n  <author>${userName}${userTitle ? ` (${userTitle})` : ''}</author>\n  <content>${msg.json.text}</content>\n  <timestamp>${msg.json.ts}</timestamp>\n</message>`;\n}).join('\\n');\n\n// Get thread metadata from first message\nconst firstMsg = threadMessages[0]?.json;\nconst threadTs = firstMsg?.thread_ts || firstMsg?.ts;\n\nreturn {\n  json: {\n    chunk: `<slack-thread id=\"${threadTs}\">\\n${formattedThread}\\n</slack-thread>`,\n    metadata: {\n      url: threadTs\n        ? `https://n8nio.slack.com/archives/${channelId}/p${threadTs.replaceAll('.', '')}`\n        : undefined,\n      message_count: threadMessages.length,\n      timestamp: $('GetThread').first().json.ts\n    }\n  }\n};"
      },
