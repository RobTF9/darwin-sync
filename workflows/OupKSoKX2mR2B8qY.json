    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH dir AS (\n  INSERT INTO public.resource (parent_id, path, kind, title)\n  SELECT r.id, ('slack.' || lower($1))::ltree, 'directory', NULLIF($3, '')\n  FROM public.resource r\n  WHERE r.path = 'slack'::ltree\n  ON CONFLICT (path) DO NOTHING\n  RETURNING id\n),\nup AS (\n  INSERT INTO public.slack_threads (channel_id, thread_ts, channel_name, title, summary, authors, message_count, permalink, started_at)\n  VALUES ($1, $2, NULLIF($3, ''), NULLIF($4, ''), NULLIF($5, ''), string_to_array(NULLIF($6, ''), ', '), NULLIF($7::text, '')::int, NULLIF($8, ''), to_timestamp($9::double precision))\n  ON CONFLICT (channel_id, thread_ts) DO UPDATE SET\n    channel_name  = COALESCE(EXCLUDED.channel_name, slack_threads.channel_name),\n    title         = COALESCE(EXCLUDED.title, slack_threads.title),\n    summary       = COALESCE(EXCLUDED.summary, slack_threads.summary),\n    authors       = COALESCE(EXCLUDED.authors, slack_threads.authors),\n    message_count = COALESCE(EXCLUDED.message_count, slack_threads.message_count),\n    permalink     = COALESCE(EXCLUDED.permalink, slack_threads.permalink),\n    updated_at    = now()\n  RETURNING *\n),\nnode_parent AS (\n  SELECT id FROM dir\n  UNION ALL\n  SELECT id FROM public.resource WHERE kind = 'directory' AND path = ('slack.' || lower($1))::ltree\n  LIMIT 1\n)\nINSERT INTO public.resource (parent_id, path, kind, source_id, title, summary, created_at)\nSELECT (SELECT id FROM node_parent),\n       ('slack.' || lower(up.channel_id) || '.t' || replace(up.thread_ts, '.', '_'))::ltree,\n       'slack_thread',\n       up.channel_id || ':' || up.thread_ts,\n       up.title,\n       up.summary,\n       COALESCE(up.started_at, now())\nFROM up\nON CONFLICT (path) DO UPDATE SET\n  parent_id = COALESCE(resource.parent_id, EXCLUDED.parent_id),\n  title     = EXCLUDED.title,\n  summary   = EXCLUDED.summary,\n  source_id = EXCLUDED.source_id\nRETURNING id, title",
        "options": {
          "queryReplacement": "={{ [$('PrepChunk').item.json.metadata.channel, $('PrepChunk').item.json.metadata.ts, $('PrepChunk').item.json.metadata.channel_name, ($json.output && $json.output.title) ? $json.output.title : $('PrepChunk').item.json.metadata.title_fallback, ($json.output && $json.output.summary) ? $json.output.summary : '', $('PrepChunk').item.json.metadata.authors, $('PrepChunk').item.json.metadata.message_count, $('PrepChunk').item.json.metadata.url, $('PrepChunk').item.json.metadata.ts] }}"
        }
      },
