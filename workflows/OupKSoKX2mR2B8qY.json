    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH dt AS (\n  DELETE FROM public.slack_threads WHERE channel_id = $1 AND thread_ts = $2 RETURNING channel_id\n),\ndl AS (\n  DELETE FROM public.ingest_ledger WHERE source = 'slack' AND source_id = $2 RETURNING 1\n)\nDELETE FROM public.resource\nWHERE kind = 'slack_thread'\n  AND path = ('slack.' || lower($1) || '.t' || replace($2, '.', '_'))::ltree\nRETURNING id",
        "options": {
