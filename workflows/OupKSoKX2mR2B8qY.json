{
  "id": "OupKSoKX2mR2B8qY",
  "name": "SlackIngestion",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Channel id/name arrive via the sub-workflow trigger input (orchestrator passthrough)\nconst channelId = $('Trigger').item.json.channel;\nconst channelName = $('Trigger').item.json.channel_name || channelId;\n\n// Get all thread messages and corresponding user profiles\nconst threadMessages = $('GetThread').all();\nconst userProfiles = $('GetUser').all();\n\n// Build a map of user id -> profile for reliable lookup (order-independent)\nconst profileMap = {};\nfor (const p of userProfiles) {\n  const prof = p.json || {};\n  const uid = prof.id || prof.user;\n  if (uid) profileMap[uid] = prof;\n}\n\n// Format each message with username, looked up by the message's author id\nconst authorNames = [];\nconst formattedThread = threadMessages.map((msg) => {\n  const profile = profileMap[msg.json.user];\n  const userName = profile?.real_name || msg.json.user;\n  const userTitle = profile?.title || '';\n  if (!authorNames.includes(userName)) authorNames.push(userName);\n\n  return `<message>\n  <author>${userName}${userTitle ? ` (${userTitle})` : ''}</author>\n  <content>${msg.json.text}</content>\n  <timestamp>${msg.json.ts}</timestamp>\n</message>`;\n}).join('\\n');\n\n// Get thread metadata from first message\nconst firstMsg = threadMessages[0]?.json;\nconst threadTs = firstMsg?.thread_ts || firstMsg?.ts;\n\n// Fallback title: first non-empty line of the first message (LLM title preferred)\nconst firstLine = (firstMsg?.text || '').split('\\n').map(l => l.trim()).find(l => l.length > 0) || 'Slack thread';\n\nreturn {\n  json: {\n    chunk: `<slack-thread id=\"${threadTs}\" channel=\"${channelName}\">\n${formattedThread}\n</slack-thread>`,\n    metadata: {\n      url: threadTs\n        ? `https://n8nio.slack.com/archives/${channelId}/p${threadTs.replaceAll('.', '')}`\n        : undefined,\n      ts: threadTs,\n      channel: channelId,\n      channel_name: channelName,\n      authors: authorNames.join(', '),\n      message_count: threadMessages.length,\n      title_fallback: firstLine.slice(0, 120),\n      timestamp: $('GetThread').first().json.ts\n    }\n  }\n};"
      },
