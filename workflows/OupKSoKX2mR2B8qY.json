    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ds AS (\n  DELETE FROM public.slack\n  WHERE (metadata->>'ts')::double precision < extract(epoch from now() - interval '3 months')\n  RETURNING metadata->>'ts' AS ts\n),\ndt AS (\n  DELETE FROM public.slack_threads\n  WHERE started_at < now() - interval '3 months'\n  RETURNING channel_id, thread_ts\n),\ndl AS (\n  DELETE FROM public.ingest_ledger\n  WHERE source = 'slack' AND (source_id IN (SELECT ts FROM ds) OR source_id IN (SELECT thread_ts FROM dt))\n  RETURNING 1\n),\ndn AS (\n  DELETE FROM public.resource\n  WHERE kind = 'slack_thread' AND path <@ 'slack'\n    AND (source_id IN (SELECT channel_id || ':' || thread_ts FROM dt)\n         OR source_id NOT IN (SELECT channel_id || ':' || thread_ts FROM public.slack_threads))\n  RETURNING 1\n)\nSELECT (SELECT count(*) FROM ds) AS vectors_deleted,\n       (SELECT count(*) FROM dt) AS threads_deleted,\n       (SELECT count(*) FROM dl) AS ledger_rows_deleted,\n       (SELECT count(*) FROM dn) AS nodes_deleted",
        "options": {}
      },
      "id": "b357a701-8075-4e74-8f7b-12553dc50624",
