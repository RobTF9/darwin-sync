              "type": "string",
              "value": "={{ $json.thread_ts || $json.ts }}"
            },
            {
              "id": "c-ch",
              "name": "channel_id",
              "type": "string",
              "value": "={{ $json.channel_id }}"
            },
            {
              "id": "c-chn",
              "name": "channel_name",
              "type": "string",
              "value": "={{ $json.channel_name }}"
            },
            {
              "id": "c-im",
              "name": "is_im",
              "type": "boolean",
              "value": "={{ $json.is_im }}"
            },
            {
              "id": "c-user",
              "name": "user",
              "type": "string",
              "value": "={{ $json.user || '' }}"
            },
            {
              "id": "c-kind",
              "name": "kind",
              "type": "string",
              "value": "={{ (!$json.bot_id && !!$json.user && !$('Config').first().json.bots.includes($json.user) && ($json.is_im || ($json.text || '').includes($('Config').first().json.mention))) ? 'initial' : 'thread_with_bot' }}"
            },
            {
              "id": "c-rc",
              "name": "reply_count",
              "type": "number",
              "value": "={{ $json.reply_count || 0 }}"
            },
            {
              "id": "c-text",
              "name": "text",
              "type": "string",
              "value": "={{ ($json.text || '').slice(0, 120) }}"
            }
          ]
        }
      }
