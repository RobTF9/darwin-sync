              "type": "string",
              "value": "={{ $('Readable Channels').item.json.name || $('Readable Channels').item.json.user || $('Readable Channels').item.json.id }}"
            },
            {
              "id": "st-im",
              "name": "is_im",
              "type": "boolean",
