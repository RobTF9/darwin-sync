{
  "id": "yPmXmK3M8nhprSLl",
  "name": "DarwinMessages",
  "description": "MCP tool sub-workflow. Lists initial (thread-starting) Slack messages that involve Darwin since a date. No reply fetching. Excludes eval channels by default. Read-only.",
  "nodes": [
    {
      "id": "24d5825b-63cd-46bf-a544-82ae58a7b36d",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        -1760,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "oldest",
              "type": "string"
            },
            {
              "name": "bot_user_id",
              "type": "string"
            },
            {
              "name": "exclude_channels",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "a9fac0ab-12cb-4d54-a691-63a234f780ad",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        -1520,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cfg-env",
              "name": "env",
              "type": "string",
              "value": "={{ $vars.env || 'production' }}"
            },
            {
              "id": "cfg-mention",
              "name": "mention",
              "type": "string",
              "value": "={{ '<@' + ((($json.bot_user_id || '').trim()) || (($vars.env || 'production') === 'staging' ? 'U0BLRFB0FJR' : 'U09Q22R53T6')) + '>' }}"
            },
            {
              "id": "cfg-bots",
              "name": "bots",
              "type": "array",
              "value": "={{ ['U09Q22R53T6', 'U0BLRFB0FJR'].concat((($json.bot_user_id || '').trim()) ? [($json.bot_user_id || '').trim()] : []) }}"
            },
            {
              "id": "cfg-oldest",
              "name": "oldest_epoch",
              "type": "string",
              "value": "={{ String(Math.floor(new Date((($json.oldest || '').trim() || '2026-07-25') + 'T00:00:00Z').getTime() / 1000)) }}"
            },
            {
              "id": "cfg-excluded",
              "name": "excluded",
              "type": "array",
              "value": "={{ ('C0BQH5S6P1P,C09DRCJLQCE,' + ($json.exclude_channels || '')).split(',').map(s => s.trim()).filter(Boolean) }}"
            },
            {
              "id": "cfg-types",
              "name": "types",
              "type": "array",
              "value": "={{ ['public_channel', 'private_channel', 'im'] }}"
            }
          ]
        }
      }
    },
    {
      "id": "9b3104be-8437-4835-a564-1b9a77669389",
      "name": "Split Types",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -1280,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "types",
        "options": {
          "destinationFieldName": "type"
        }
      }
    },
    {
      "id": "4bb1ff07-55bc-4b67-8591-8f5854ef162e",
      "name": "List Conversations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -1040,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://slack.com/api/users.conversations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "types",
              "value": "={{ $json.type }}"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 500
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "cursor",
                    "value": "={{ $response.body.response_metadata ? $response.body.response_metadata.next_cursor : \"\" }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.response_metadata || !$response.body.response_metadata.next_cursor }}",
              "requestInterval": 400
            }
          }
        }
      },
      "credentials": {
        "slackApi": {
          "id": "BBkWcmrv3sWmNe1t",
          "name": "Slack Bot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
