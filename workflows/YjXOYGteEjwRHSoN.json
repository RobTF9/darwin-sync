      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Aggregate the inserted rows into one item so the dispatcher fires ONCE.\nconst rows = $input.all();\nreturn [{ json: { run_id: $('Generate Run ID').first().json.run_id, dispatched: rows.length } }];"
      }
