{
  "id": "YjXOYGteEjwRHSoN",
  "name": "FanOutAgent",
  "description": "fan_out tool for FirstClassDarwin: takes items (≤25), instruction, context; inserts fan_out_item tracking rows; fires one FanOutAgentWorker execution per item (parallel); polls every 10s until done or 15 min; returns per-item results in one payload.",
  "nodes": [
    {
      "id": "f767d9ce-7a2d-4e94-a3a2-a63b587960d2",
      "name": "Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        128
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "items"
            },
            {
              "name": "instruction"
            },
            {
              "name": "context"
            }
          ]
        }
      }
    },
    {
      "id": "a625e8c2-237d-418a-a2a9-c0341c3bbb8c",
      "name": "Generate Run ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        128
      ],
      "parameters": {
        "jsCode": "// Validate the batch and stamp a run id + deadline. Mirrors the old Darwin\n// FanOut (6lVlut82xPoebENQ) minus the nesting guard: children are the\n// SonOfFanOut agent, which has no fan_out tool, so nesting is impossible\n// by construction.\nconst crypto = require('crypto');\nconst runId = crypto.randomUUID();\nconst input = $input.first().json;\n\nlet items = input.items;\nif (typeof items === 'string') {\n  try { items = JSON.parse(items); } catch (e) { items = items.trim() ? [items] : []; }\n}\nif (!Array.isArray(items)) items = (items === null || items === undefined) ? [] : [items];\n\nconst MAX_ITEMS = 25;\nif (!items.length) {\n  return [{ json: { run_id: runId, blocked: true, error: 'fan_out requires a non-empty items array.' } }];\n}\nif (items.length > MAX_ITEMS) {\n  return [{ json: { run_id: runId, blocked: true, error: 'fan_out supports at most ' + MAX_ITEMS + ' items per call (got ' + items.length + '). Split into multiple calls or narrow the item list.' } }];\n}\n\nreturn [{\n  json: {\n    run_id: runId,\n    items,\n    instruction: input.instruction,\n    context: input.context || '',\n    deadline: $now.plus({ minutes: 15 }).toISO(),\n    blocked: false\n  }\n}];"
      }
    },
    {
      "id": "e8679df4-d470-4571-a4e3-8d2b058e4f1f",
      "name": "Is Blocked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        128
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.blocked }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
