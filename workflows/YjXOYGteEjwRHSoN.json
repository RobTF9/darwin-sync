      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Instant tool return: the agent collects results later via fan_out_results.\nconst c = $('Collect').first().json;\nreturn [{ json: {\n  run_id: c.run_id,\n  status: 'dispatched',\n  items_dispatched: c.dispatched,\n  next_step: 'Items are processing in parallel in the background. Call wait for 90 seconds, then call fan_out_results with run_id=' + c.run_id + '. If it reports pending > 0, wait 60 more seconds and call fan_out_results again.'\n} }];"
      }
    }
