    {
      "parameters": {
        "jsCode": "const init = $(\"Init\").item.json;\nconst exec = $input.first().json;\nconst status = exec.status || (exec.finished === false ? \"running\" : \"success\");\nconst elapsedSec = Math.round((Date.now() - init.startedAtMs) / 1000);\nconst running = [\"running\",\"waiting\",\"new\",\"unknown\"].includes(status);\nconst timedOut = elapsedSec >= init.maxWaitSeconds;\nconst keepPolling = running && !timedOut;\nreturn [{ json: {\n  verdict: keepPolling ? \"poll\" : \"done\",\n  status,\n  executionId: init.executionId,\n  elapsedSeconds: elapsedSec,\n  maxWaitSeconds: init.maxWaitSeconds,\n  stoppedAt: exec.stoppedAt || null,\n  keepPolling,\n  timedOut: timedOut && running,\n  finished: !running,\n} }];"
      },
      "id": "ab89d021-b086-48a8-bfcd-ba56bf9f424d",
      "name": "Evaluate",
      "type": "n8n-nodes-base.code",
