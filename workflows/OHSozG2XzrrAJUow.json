    {
      "parameters": {
        "jsCode": "const init = $(\"Init\").item.json;\nconst e = $input.first().json;\nlet result;\nif (e.timedOut) {\n  result = {\n    status: \"timeout\",\n    executionId: e.executionId,\n    elapsedSeconds: e.elapsedSeconds,\n    message: \"Execution still running after \" + e.elapsedSeconds + \"s (max \" + init.maxWaitSeconds + \"s). Poll again or inspect manually.\"\n  };\n} else {\n  result = { status: e.status, executionId: e.executionId, stoppedAt: e.stoppedAt, elapsedSeconds: e.elapsedSeconds, finished: e.finished };\n}\nreturn [{ json: result }];"
      },
