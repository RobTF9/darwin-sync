    {
      "id": "f2dfef7d-0c4d-4498-be04-1a605a4db3f5",
      "name": "Compute Balance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Reads the Tremendous balance and decides if the admin must be told.\n// source 'daily': schedule or manual run. DM the admin when below the threshold.\n// source 'order': called by PF Reward before an order. DM the admin only when the order is blocked.\nlet input = {};\ntry { input = $('When Called By Another Workflow').first().json; } catch (e) { input = {}; }\nconst cfg = $('Load Config').first().json;\nconst source = input.source || 'daily';\nconst amount = Number(input.amount || 0);\n\nif (cfg.tremendousMode !== 'stub') {\n  throw new Error(`Tremendous mode \"${cfg.tremendousMode}\" is not built yet. Only \"stub\" works in this build.`);\n}\nconst balance = Number(cfg.mockBalanceUsd);\nconst threshold = Number(cfg.balanceThresholdUsd);\nconst belowThreshold = balance < threshold;\nconst enough = amount > 0 ? balance >= amount : true;\nconst notify = (source === 'daily' && belowThreshold) || (source === 'order' && !enough);\n\nconst tag = cfg.mockMode ? '[MOCK] ' : '';\nconst stubNote = cfg.tremendousMode === 'stub' ? ' (stub balance from PF Config)' : '';\nlet adminText = '';\nif (source === 'order') {\n  adminText = `${tag}A $${amount} reward for ${input.participant_name || 'a participant'} (host: ${input.host_name || 'unknown'}) was blocked: the Tremendous balance is $${balance}${stubNote}. Please refill it. The host can then send the reward again through Darwin.`;\n} else {\n  adminText = `${tag}The Tremendous balance is $${balance}${stubNote}. This is below $${threshold}. Please refill it.`;\n}\n\nreturn [{\n  json: {\n    source,\n    balance,\n    threshold,\n    below_threshold: belowThreshold,\n    amount,\n    enough,\n    notify,\n    admin_email: (cfg.adminEmail || '').toLowerCase(),\n    admin_allowed: !cfg.mockMode || cfg.allowedHostEmails.includes((cfg.adminEmail || '').toLowerCase()),\n    admin_text: adminText,\n  },\n}];\n"
      }
    },
