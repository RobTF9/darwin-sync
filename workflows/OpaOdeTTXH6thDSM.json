    {
      "id": "f2dfef7d-0c4d-4498-be04-1a605a4db3f5",
      "name": "Compute Balance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Reads the Tremendous balance and decides if the admin must be told.\n// source 'daily': schedule or manual run. DM the admin when below the threshold.\n// source 'order': called by PF Reward before an order. DM the admin only when the order is blocked.\n// Live balance only on production (credential Tremendous Production); stub everywhere else.\nlet input = {};\ntry { input = $('When Called By Another Workflow').first().json; } catch (e) { input = {}; }\nconst cfg = $('Load Config').first().json;\nconst source = input.source || 'daily';\nconst amount = Number(input.amount || 0);\nconst live = cfg.tremendousMode === 'live' && cfg.environment === 'production' && !cfg.mockMode;\n\nlet balance = null;\nlet balanceError = null;\nif (live) {\n  let res = null;\n  try { res = $('Get Balance Source').first().json; } catch (e) { res = null; }\n  const value = res?.body?.funding_source?.meta?.available_amount;\n  if (Number(res?.statusCode) === 200 && typeof value === 'number') balance = value;\n  else balanceError = `Tremendous answered ${res?.statusCode ?? 'no response'}`;\n} else {\n  balance = Number(cfg.mockBalanceUsd);\n}\n\nconst threshold = Number(cfg.balanceThresholdUsd);\nconst known = balanceError === null;\nconst belowThreshold = known && balance < threshold;\nconst enough = known && (amount > 0 ? balance >= amount : true);\n// An unknown balance always goes to the admin, and never lets an order through.\nconst notify = !known || (source === 'daily' && belowThreshold) || (source === 'order' && !enough);\n\nconst tag = cfg.mockMode ? '[MOCK] ' : '';\nconst stubNote = live ? '' : ' (stub balance from PF Config)';\nconst who = input.participant_name || 'a participant';\nconst host = input.host_name || 'unknown';\nlet adminText = '';\nif (!known) {\n  adminText = source === 'order'\n    ? `${tag}I could not read the Tremendous balance (${balanceError}), so a $${amount} reward for ${who} (host: ${host}) was not sent. Please check the Tremendous Production credential and the balance. The host can then send it again through Darwin.`\n    : `${tag}I could not read the Tremendous balance (${balanceError}). Please check the Tremendous Production credential on production.`;\n} else if (source === 'order') {\n  adminText = `${tag}A $${amount} reward for ${who} (host: ${host}) was blocked: the Tremendous balance is $${balance}${stubNote}. Please refill it. The host can then send the reward again through Darwin.`;\n} else {\n  adminText = `${tag}The Tremendous balance is $${balance}${stubNote}. This is below $${threshold}. Please refill it.`;\n}\n\nreturn [{\n  json: {\n    source,\n    balance: known ? balance : 0,\n    balance_known: known,\n    balance_error: balanceError,\n    threshold,\n    below_threshold: belowThreshold,\n    amount,\n    enough,\n    notify,\n    admin_email: (cfg.adminEmail || '').toLowerCase(),\n    admin_allowed: !cfg.mockMode || cfg.allowedHostEmails.includes((cfg.adminEmail || '').toLowerCase()),\n    admin_text: adminText,\n  },\n}];\n"
      }
    },
