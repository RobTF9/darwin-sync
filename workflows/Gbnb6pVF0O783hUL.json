      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One input shape for both entry points: Darwin's tool call or the manual test run.\nlet input = {};\ntry { input = $('When Called By Darwin').first().json; } catch (e) { input = {}; }\nif (!input.user_id) {\n  try { input = $('Test Input').first().json; } catch (e) { input = {}; }\n}\nreturn [{\n  json: {\n    user_id: input.user_id || '',\n    session_number: input.session_number ? Number(input.session_number) : null,\n    invitee_uri: input.invitee_uri || null,\n  },\n}];\n"
      }
    },
