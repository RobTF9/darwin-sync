      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "L3Sa3FfY5RtqeUgk",
          "cachedResultName": "MOCK - PF Sessions"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "host_email",
              "condition": "eq",
