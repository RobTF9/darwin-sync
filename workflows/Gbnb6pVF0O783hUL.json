    {
      "id": "abb111de-60d7-4575-8213-1a105279e004",
      "name": "Pick Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Finds the host's open sessions and decides what to start.\nconst input = $('Resolve Input').first().json;\nconst cfg = $('Load Config').first().json;\nconst tz = cfg.timezone;\nconst host = $('Find Host By Slack Id').first().json;\nconst hostEmail = (host.user?.profile?.email || '').toLowerCase();\n\nconst say = (action, response, extra = {}) => [{ json: { action, response, host_email: hostEmail, ...extra } }];\n\nif (!host.ok || !hostEmail) {\n  return say('none', 'I could not find your email address in Slack, so I cannot look up your sessions.');\n}\nif (cfg.mockMode && !cfg.allowedHostEmails.includes(hostEmail)) {\n  return say('none', 'Test mode: this feature only works for the test host right now.');\n}\n\nconst OPEN = {\n  unanswered: 'not confirmed yet',\n  showed_up: 'joined, no reward yet',\n  reward_blocked: 'reward blocked, balance was too low',\n};\nconst now = $now.toMillis();\nconst since = $now.minus({ days: cfg.manualLookbackDays }).toMillis();\nconst rows = $('Get Host Sessions').all().map((i) => i.json).filter((r) => r.id);\nconst open = rows\n  .filter((r) => r.booking_status === 'active' && OPEN[r.followup_status])\n  .filter((r) => { const t = DateTime.fromISO(r.starts_at).toMillis(); return t <= now && t >= since; })\n  .sort((a, b) => DateTime.fromISO(b.starts_at).toMillis() - DateTime.fromISO(a.starts_at).toMillis());\n\nconst label = (r, i) => `${i + 1}. ${r.participant_name || r.participant_email}, ${DateTime.fromISO(r.starts_at).setZone(tz).toFormat('ccc d LLL, HH:mm')} (${OPEN[r.followup_status]})`;\n\nif (open.length === 0) {\n  return say('none', `You have no open sessions from the last ${cfg.manualLookbackDays} days. Every session is rewarded, declined or marked as a no-show.`);\n}\n\nlet chosen = null;\nif (input.invitee_uri) chosen = open.find((r) => r.invitee_uri === input.invitee_uri) || null;\nelse if (input.session_number) chosen = open[Number(input.session_number) - 1] || null;\nelse if (open.length === 1) chosen = open[0];\n\nif (!chosen) {\n  const wrongPick = input.session_number || input.invitee_uri ? 'I could not find that session. ' : '';\n  return say('list', `${wrongPick}You have ${open.length} open sessions:\\n${open.map(label).join('\\n')}\\nWhich one do you mean? Reply with the number.`, {\n    sessions: open.map((r, i) => ({ number: i + 1, invitee_uri: r.invitee_uri, participant: r.participant_name, starts_at: r.starts_at, status: r.followup_status })),\n  });\n}\n\nconst who = chosen.participant_name || chosen.participant_email;\nconst day = DateTime.fromISO(chosen.starts_at).setZone(tz).toFormat('ccc d LLL');\nif (chosen.followup_status === 'unanswered') {\n  return say('followup', `OK. I sent you a DM to confirm if ${who} joined your session on ${day}. If yes, I will then ask about the reward.`, { invitee_uri: chosen.invitee_uri });\n}\nreturn say('reward', `OK. I sent you a DM to choose the reward for ${who} (session on ${day}).`, { invitee_uri: chosen.invitee_uri });\n"
      }
    },
