      "name": "Parse Case",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $json;\nlet inputs = {}; let assertions = [];\ntry { inputs = JSON.parse(c.inputs || '{}'); } catch (e) { inputs = {}; }\ntry { assertions = JSON.parse(c.assertions || '[]'); } catch (e) { assertions = []; }\nconst targetType = c.target_type || 'workflow';\nreturn { json: { run_id: c.run_id || '', case_id: c.case_id, target_type: targetType, target: c.target, agent: c.agent || '', description: c.description || '', inputs, assertions, target_key: targetType === 'sql' ? 'sql' : c.target } };"
      }
    },
    {
      "id": "2190f608-7202-42c3-b4ca-5ba2df107f10",
      "name": "Evaluate Assertions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const caseData = $('Parse Case').first().json;\nconst rows = $input.all().map((i) => i.json);\nconst details = [];\nlet status = 'pass';\nfunction getPath(obj, path) { return path.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj); }\nif (rows.length === 0) {\n  status = 'error';\n  details.push({ assertion: 'execution', pass: false, detail: 'Target returned no output items' });\n} else if (rows[0] && rows[0].error) {\n  status = 'error';\n  details.push({ assertion: 'execution', pass: false, detail: JSON.stringify(rows[0].error).slice(0, 600) });\n} else {\n  for (const a of caseData.assertions) {\n    let pass = false; let got;\n    try {\n      if (a.type === 'row_count') {\n        got = rows.length;\n        const v = Number(a.value);\n        pass = a.op === '>=' ? got >= v : a.op === '<=' ? got <= v : got === v;\n      } else if (a.type === 'field_exists') {\n        got = getPath(rows[0], a.path);\n        pass = got !== undefined && got !== null;\n      } else if (a.type === 'contains') {\n        got = '(substring search)';\n        pass = JSON.stringify(rows).includes(a.value);\n      } else if (a.type === 'exact') {\n        got = a.path ? getPath(rows[0], a.path) : (rows.length === 1 ? rows[0] : rows);\n        pass = JSON.stringify(got) === JSON.stringify(a.value);\n      } else if (a.type === 'tool_called') {\n        got = rows[0].tools_used || [];\n        pass = got.includes(a.value);\n      } else {\n        status = 'fail';\n        details.push({ assertion: String(a.type), pass: false, detail: 'unknown assertion type' });\n        continue;\n      }\n    } catch (e) {\n      status = 'fail';\n      details.push({ assertion: String(a.type), pass: false, detail: String(e).slice(0, 300) });\n      continue;\n    }\n    if (!pass) status = 'fail';\n    details.push({ assertion: a.type + (a.path ? ' ' + a.path : ''), pass, expected: a.value, got: typeof got === 'string' ? got.slice(0, 200) : got });\n  }\n}\nreturn [{ json: { run_id: caseData.run_id || '', case_id: caseData.case_id, target: caseData.target, status, actual_output: JSON.stringify(rows).slice(0, 3500), assertion_detail: JSON.stringify(details).slice(0, 3500) } }];"
      }
    },
