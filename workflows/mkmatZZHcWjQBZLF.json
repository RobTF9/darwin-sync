    {
      "id": "d56433a5-5737-4a34-9ea1-c5cdfda074b9",
      "name": "Count & Percentage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Build user-id -> display name map from Get Users node\nconst nameMap = {};\nfor (const u of $('Get Users').all()) {\n  const j = u.json;\n  if (j && j.id) {\n    nameMap[j.id] = (j.profile && (j.profile.real_name || j.profile.display_name)) || j.real_name || j.name || j.id;\n  }\n}\n\nconst linkRe = /gong\\.io|pidgeonhead/i;\nconst counts = {};\nlet total = 0;\nfor (const item of $('Get Channel History').all()) {\n  const text = item.json.text || '';\n  if (linkRe.test(text)) {\n    const uid = item.json.user || item.json.username || 'unknown';\n    counts[uid] = (counts[uid] || 0) + 1;\n    total++;\n  }\n}\n\nconst rows = Object.entries(counts).map(([uid, count]) => ({\n  json: {\n    user: nameMap[uid] || uid,\n    count,\n    percentage: total ? (Math.round((count / total) * 1000) / 10) + '%' : '0%'\n  }\n}));\nrows.sort((a, b) => b.json.count - a.json.count);\nif (rows.length === 0) {\n  return [{ json: { user: 'none', count: 0, percentage: '0%' } }];\n}\nreturn rows;"
      }
    },
