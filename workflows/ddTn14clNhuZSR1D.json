    {
      "id": "3a47f269-2b59-4e65-997e-e9fecdbff27d",
      "name": "Count Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const runId = $('Input').first().json.run_id;\nconst expectedCount = parseInt($('Input').first().json.expected_count, 10) || 0;\nconst pollCount = ($runIndex || 0) + 1;\nconst rows = $input.all().map(i => i.json);\nconst matching = rows.filter(r => String(r.run_id) === String(runId));\nconst count = matching.length;\nconst complete = count >= expectedCount;\nconst timeout = pollCount >= 20;\nreturn [{ json: {\n  run_id: runId,\n  expected_count: expectedCount,\n  count: count,\n  poll_count: pollCount,\n  complete: complete,\n  timeout: timeout,\n  results: matching,\n  slack_channel: $('Input').first().json.slack_channel,\n  slack_thread_ts: $('Input').first().json.slack_thread_ts,\n} }];"
      }
    },
    {
      "id": "a8c59e39-2462-484d-a9a7-b57dd0e54924",
      "name": "Is Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.complete }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.timeout }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "c3fa9e91-608b-4545-a629-62083b53203e",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $input.first().json;\nconst results = Array.isArray(data.results) ? data.results : [];\nconst timedOut = data.timeout && !data.complete;\nconst pass = results.filter((r) => r.status === 'pass').length;\nconst failures = results.filter((r) => r.status !== 'pass');\nconst lines = [];\nlines.push('*Integration Results — run `' + data.run_id + '`*');\nif (timedOut) lines.push('_:warning: Timed out waiting for all results (' + data.count + '/' + data.expected_count + ' received)_');\nlines.push('');\nlines.push(':white_check_mark: Pass: ' + pass);\nlines.push(':x: Fail/Error: ' + failures.length);\nlines.push('Total: ' + results.length);\nif (failures.length) {\n  lines.push('');\n  lines.push('*Failures*');\n  for (const r of failures) {\n    let detail = '';\n    try {\n      const d = JSON.parse(r.assertion_detail || '[]');\n      const bad = d.find((x) => !x.pass);\n      detail = bad ? ' — ' + bad.assertion + ': ' + JSON.stringify(bad.got ?? bad.detail ?? '').slice(0, 120) : '';\n    } catch (e) {}\n    lines.push('• ' + r.case_id + ' (' + r.target + '): ' + r.status + detail);\n  }\n}\nreturn [{ json: { summary: lines.join('\\n'), slack_channel: data.slack_channel, slack_thread_ts: data.slack_thread_ts, pass, fail: failures.length, total: results.length } }];"
      }
    },
    {
      "id": "7f4b821e-1aff-4156-9d8d-b60bc4efa28b",
      "name": "Post to Thread",
      "type": "n8n-nodes-base.slack",
