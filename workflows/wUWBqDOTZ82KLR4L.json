    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH dir AS (\n  INSERT INTO public.resource (parent_id, path, kind, source_id, title, created_at)\n  SELECT r.id, ('forum.t' || $1)::ltree, 'directory', $1, NULLIF($2, ''), now()\n  FROM public.resource r WHERE r.path = 'forum'::ltree\n  ON CONFLICT (path) DO UPDATE SET title = COALESCE(EXCLUDED.title, resource.title)\n  RETURNING id\n),\nparent AS (\n  SELECT id FROM dir\n  UNION ALL SELECT id FROM public.resource WHERE kind = 'directory' AND path = ('forum.t' || $1)::ltree\n  LIMIT 1\n),\nleaf AS (\n  INSERT INTO public.resource (parent_id, path, kind, source_id, title, created_at)\n  SELECT (SELECT id FROM parent),\n         ('forum.t' || $1 || '.p' || $3)::ltree,\n         'forum_topic',\n         (SELECT f.id::text FROM public.forum f WHERE f.metadata->>'post_id' = $4 ORDER BY f.id LIMIT 1),\n         NULLIF($2, ''), now()\n  ON CONFLICT (path) DO UPDATE SET title = COALESCE(EXCLUDED.title, resource.title)\n  RETURNING id\n),\nft AS (\n  INSERT INTO public.forum_threads (topic_id, title, slug, category_id, solved, url, original_username,\n                                    started_at, last_posted_at, post_count)\n  VALUES ($1, NULLIF($2, ''), NULLIF($6, ''), NULLIF($7, ''), $8::boolean, NULLIF($9, ''),\n          NULLIF($10, ''), NULLIF($11, '')::timestamptz, NULLIF($11, '')::timestamptz,\n          (SELECT count(*) FROM public.forum f WHERE f.metadata->>'topic_id' = $1))\n  ON CONFLICT (topic_id) DO UPDATE SET\n    title          = COALESCE(EXCLUDED.title, forum_threads.title),\n    slug           = COALESCE(EXCLUDED.slug, forum_threads.slug),\n    category_id    = COALESCE(EXCLUDED.category_id, forum_threads.category_id),\n    solved         = EXCLUDED.solved,\n    post_count     = (SELECT count(*) FROM public.forum f WHERE f.metadata->>'topic_id' = $1),\n    started_at     = LEAST(forum_threads.started_at, EXCLUDED.started_at),\n    last_posted_at = GREATEST(forum_threads.last_posted_at, EXCLUDED.last_posted_at),\n    updated_at     = now()\n  RETURNING topic_id\n),\nled AS (\n  INSERT INTO public.ingest_ledger (source, source_id, content_hash, chunk_version, embed_model, status, ingested_at)\n  VALUES ('forum', $4, md5($5), 1, 'text-embedding-3-large', 'done', now())\n  ON CONFLICT (source, source_id) DO NOTHING\n  RETURNING source_id\n)\nSELECT (SELECT id FROM leaf) AS leaf_node, (SELECT source_id FROM led) AS ledger_row, (SELECT topic_id FROM ft) AS thread_row",
        "options": {
          "queryReplacement": "={{ [$('PreparePost').item.json.metadata.topic_id, $('PreparePost').item.json.metadata.topic_title, $('PreparePost').item.json.metadata.post_number, $('PreparePost').item.json.metadata.post_id, $('PreparePost').item.json.text, $('PreparePost').item.json.metadata.topic_slug, $('PreparePost').item.json.metadata.topic_category, $('PreparePost').item.json.metadata.topic_solved, $('PreparePost').item.json.metadata.topic_url, $('PreparePost').item.json.metadata.post_number === 1 ? $('PreparePost').item.json.metadata.post_username : '', $('PreparePost').item.json.metadata.post_created_at] }}"
        }
      },
