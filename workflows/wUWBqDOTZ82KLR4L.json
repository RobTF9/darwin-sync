    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH r AS (\n  UPDATE public.resource SET summary = COALESCE(NULLIF($2, ''), summary)\n  WHERE kind = 'directory' AND path = ('forum.t' || $1)::ltree\n  RETURNING id\n),\nft AS (\n  UPDATE public.forum_threads SET summary = COALESCE(NULLIF($2, ''), summary), updated_at = now()\n  WHERE topic_id = $1\n  RETURNING topic_id\n),\nf AS (\n  UPDATE public.forum SET metadata = metadata || jsonb_build_object('summary', $2)\n  WHERE metadata->>'topic_id' = $1 AND NULLIF($2, '') IS NOT NULL\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM r) AS nodes_updated,\n       (SELECT count(*) FROM ft) AS threads_updated,\n       (SELECT count(*) FROM f) AS posts_updated",
        "options": {
          "queryReplacement": "={{ [$('GetTopicText').item.json.topic_id, ($json.output && $json.output.summary) ? $json.output.summary : ''] }}"
        }
      },
