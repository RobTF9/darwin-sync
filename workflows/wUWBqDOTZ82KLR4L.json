        "query": "WITH old_posts AS (\n  SELECT id, metadata->>'post_id' AS post_id, metadata->>'topic_id' AS topic_id\n  FROM public.forum\n  WHERE (metadata->>'post_created_at')::timestamptz < now() - interval '3 months'\n),\ndp AS (\n  DELETE FROM public.forum WHERE id IN (SELECT id FROM old_posts) RETURNING id\n),\ndl AS (\n  DELETE FROM public.ingest_ledger\n  WHERE source = 'forum' AND source_id IN (SELECT post_id FROM old_posts)\n  RETURNING 1\n),\ndn AS (\n  DELETE FROM public.resource\n  WHERE kind = 'forum_topic' AND path <@ 'forum'\n    AND (source_id::bigint IN (SELECT id FROM old_posts)\n         OR source_id::bigint NOT IN (SELECT id FROM public.forum))\n  RETURNING 1\n),\ndd AS (\n  DELETE FROM public.resource d\n  WHERE d.kind = 'directory' AND d.path::text ~ '^forum\\.t[0-9]+$'\n    AND NOT EXISTS (\n      SELECT 1 FROM public.forum f\n      WHERE f.metadata->>'topic_id' = d.source_id\n        AND (f.metadata->>'post_created_at')::timestamptz >= now() - interval '3 months'\n    )\n  RETURNING 1\n),\ndf AS (\n  DELETE FROM public.forum_threads ft\n  WHERE NOT EXISTS (\n    SELECT 1 FROM public.forum f\n    WHERE f.metadata->>'topic_id' = ft.topic_id\n      AND (f.metadata->>'post_created_at')::timestamptz >= now() - interval '3 months'\n  )\n  RETURNING 1\n)\nSELECT (SELECT count(*) FROM dp) AS posts_deleted,\n       (SELECT count(*) FROM dl) AS ledger_rows_deleted,\n       (SELECT count(*) FROM dn) AS leaf_nodes_deleted,\n       (SELECT count(*) FROM dd) AS topic_dirs_deleted,\n       (SELECT count(*) FROM df) AS forum_threads_deleted",
        "options": {}
      },
