    {
      "id": "d779581e-b689-4ed2-8817-17723c8e31c1",
      "name": "Delete Compare Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        4256,
        -120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- The second run existed only to be compared against. The score is already\n-- stored on the run the reviewer sees, so this run is now dead weight - and\n-- leaving it would show its ~80 quotes a second time on the session timelines.\n-- Deleting the insights cascades to their clips and finding links.\n-- Guarded so it can never remove the run the reviewer sees, and a missing\n-- compare run simply matches nothing.\nwith target as (\n  select nullif($1,'')::uuid as compare_run, nullif($2,'')::uuid as primary_run\n)\ndelete from project_insight pi\nusing target t\nwhere pi.run_id = t.compare_run\n  and t.compare_run is distinct from t.primary_run\nreturning pi.id",
        "options": {
          "queryReplacement": "={{ $('Read Compare Run Id').first().json.compare_run_id }},{{ $('Read L3 Run Ids').first().json.run_id }}"
        },
        "alwaysOutputData": true
      },
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      },
      "onError": "continueRegularOutput",
      "executeOnce": true
    },
