      "parameters": {
        "operation": "executeQuery",
        "query": "-- The newest complete insight run that is NOT the one the reviewer sees.\nselect run_id::text as compare_run_id\nfrom project_insight\nwhere project_id = $1::uuid\n  and completed_at is not null\n  and run_id <> $2::uuid\ngroup by run_id\norder by max(created_at) desc\nlimit 1",
        "options": {
