      "parameters": {
        "jsCode": "const runId = $(\"Format Cases\").first().json.run_id;\nconst caseCount = $(\"Format Cases\").all().length;\nlet channel = ''; let threadTs = '';\ntry { channel = $(\"Manual Input\").first().json.slack_channel || ''; threadTs = $(\"Manual Input\").first().json.slack_thread_ts || ''; } catch (e) {}\nconst hasThread = Boolean(channel) && Boolean(threadTs);\nconst message = hasThread\n  ? (`Dispatched ${caseCount} integration cases in parallel. Results will be posted to the thread when complete.`)\n  : (`Dispatched ${caseCount} integration cases in parallel. Results available via integration_read tool.`);\nreturn [{ json: { run_id: runId, case_count: caseCount, status: 'dispatched', message } }];"
