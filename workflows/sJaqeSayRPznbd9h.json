    {
      "parameters": {
        "jsCode": "const paragraphs = $input.first().json.results.channels[0].alternatives[0].paragraphs.paragraphs;\n\nconst CHUNK_TOKENS = 1000;\nconst OVERLAP_TOKENS = 100;\n\nfunction estimateTokens(text) {\n  return Math.ceil(text.length / 4);\n}\n\nfunction getText(para) {\n  const text = para.sentences.map(s => s.text.trim()).join(' ');\n  return `Speaker ${para.speaker}: ${text}`;\n}\n\nconst paras = paragraphs.map(p => {\n  const text = getText(p);\n  return { text, tokens: estimateTokens(text), start: p.start, end: p.end, speaker: p.speaker };\n});\n\nconst chunks = [];\nlet i = 0;\n\nwhile (i < paras.length) {\n  let tokenCount = 0;\n  let j = i;\n\n  while (j < paras.length && tokenCount + paras[j].tokens <= CHUNK_TOKENS) {\n    tokenCount += paras[j].tokens;\n    j++;\n  }\n  if (j === i) j = i + 1;\n\n  const window = paras.slice(i, j);\n\n  chunks.push({\n    json: {\n      session_id: $('create_session').first().json.id,\n      index: chunks.length,\n      text: window.map(p => p.text).join('\\n'),\n      start: window[0].start,\n      end: window[window.length - 1].end,\n      speakers: [...new Set(window.map(p => p.speaker))],\n      duration_seconds: Math.round((window[window.length - 1].end - window[0].start) * 100) / 100,\n      token_estimate: tokenCount,\n    }\n  });\n\n  let overlapTokens = 0;\n  let nextStart = j;\n  while (nextStart > i + 1 && overlapTokens < OVERLAP_TOKENS) {\n    nextStart--;\n    overlapTokens += paras[nextStart].tokens;\n  }\n\n  i = Math.max(nextStart, i + 1);\n}\n\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        1728
      ],
      "id": "2781ad26-83a1-418a-91a6-4db5c81f610b",
      "name": "chunks"
    },
