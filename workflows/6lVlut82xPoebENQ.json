    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst runId = crypto.randomUUID();\nconst input = $input.first().json;\n\nlet items = input.items;\nif (typeof items === 'string') {\n  try { items = JSON.parse(items); } catch (e) { items = items.trim() ? [items] : []; }\n}\nif (!Array.isArray(items)) items = (items === null || items === undefined) ? [] : [items];\n\nconst MAX_ITEMS = 25;\nconst parentSessionId = String(input.parent_session_id || '');\nconst isNestedFanOut = parentSessionId.indexOf('fanout-') === 0;\n\nif (isNestedFanOut) {\n  return [{ json: { run_id: runId, blocked: true, error: 'fan_out cannot be called recursively from within an already-fanned-out sub-run (max depth 1). Do this step without fan_out, or restructure so fan_out is only called from the top-level conversation.' } }];\n}\nif (!items.length) {\n  return [{ json: { run_id: runId, blocked: true, error: 'fan_out requires a non-empty items array.' } }];\n}\nif (items.length > MAX_ITEMS) {\n  return [{ json: { run_id: runId, blocked: true, error: 'fan_out supports at most ' + MAX_ITEMS + ' items per call (got ' + items.length + '). Split into multiple calls or narrow the item list.' } }];\n}\n\nreturn [{\n  json: {\n    run_id: runId,\n    items,\n    instruction: input.instruction,\n    context: input.context || '',\n    parent_env: input.parent_env || 'staging',\n    deadline: $now.plus({ minutes: 25 }).toISO(),\n    blocked: false\n  }\n}];"
      },
