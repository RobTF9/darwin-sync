    {
      "parameters": {
        "jsCode": "const results = $('Fetch Results').all();\nconst runId = $('Generate Run ID').first().json.run_id;\nconst instruction = $('Generate Run ID').first().json.instruction;\n\nconst completed = results.filter(r => r.json.status === 'complete');\nconst errors = results.filter(r => r.json.status === 'error');\n\nreturn [{\n  json: {\n    run_id: runId,\n    instruction,\n    total_items: results.length,\n    completed: completed.length,\n    errors: errors.length,\n    results: results.map(r => {\n      let resp = r.json.response;\n      if (typeof resp === 'string') {\n        try { resp = JSON.parse(resp); } catch (e) {}\n      }\n      let item = r.json.item;\n      if (typeof item === 'string') {\n        try { item = JSON.parse(item); } catch (e) {}\n      }\n      return { item_index: r.json.item_index, item, status: r.json.status, response: resp };\n    })\n  }\n}];"
      },
