    {
      "id": "9296f51f-9048-4add-800c-8e425303b3a3",
      "name": "Prepare Follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Checks the session can be asked about, then builds the Slack texts and wait limits.\nconst input = $('When Called By Another Workflow').first().json;\nconst cfg = $('Load Config').first().json;\nconst row = $('Get Session Row').first().json ?? {};\nconst mode = input.mode || 'auto';\n\nlet blockStatus = null;\nif (!row.id) blockStatus = 'skipped_no_row';\nelse if (row.booking_status !== 'active') blockStatus = 'skipped_not_active';\nelse if (cfg.mockMode && !cfg.allowedHostEmails.includes((row.host_email || '').toLowerCase())) blockStatus = 'guard_blocked';\n\nconst tz = cfg.timezone;\nconst start = DateTime.fromISO(row.starts_at || $now.toISO()).setZone(tz);\nconst end = DateTime.fromISO(row.ends_at || $now.toISO());\n// Wait for the first answer until the session ends, but at least 2 minutes.\nconst minAsk = $now.plus({ minutes: 2 });\nconst askUntil = (end > minAsk ? end : minAsk).toUTC().toISO();\nconst secondsToEnd = Math.max(1, Math.ceil((end.toMillis() - $now.toMillis()) / 1000));\n\nconst tag = cfg.mockMode ? '[MOCK] ' : '';\nconst hostFirst = (row.host_name || '').split(' ')[0] || 'there';\nconst who = row.participant_name || row.participant_email || 'the participant';\nconst first = row.participant_first_name || who;\nconst when = start.toFormat('HH:mm');\n\nreturn [{\n  json: {\n    ok: blockStatus === null,\n    block_status: blockStatus,\n    mode,\n    invitee_uri: row.invitee_uri ?? input.invitee_uri,\n    host_email: row.host_email,\n    ask_until: askUntil,\n    seconds_to_end: secondsToEnd,\n    reminder_minutes: cfg.finalTimeoutMinutes,\n    ask_text: `${tag}Hi ${hostFirst}, your session \"${row.event_name}\" with ${who} started at ${when} (${tz}). Did ${first} join?`,\n    remind_text: `${tag}Reminder: did ${who} join your session \"${row.event_name}\" at ${when} (${tz})? If you do not answer, I will stop asking. You can still tell Darwin later.`,\n  },\n}];\n"
      }
    },
