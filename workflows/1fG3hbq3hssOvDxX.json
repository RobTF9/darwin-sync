    {
      "id": "382b4175-b084-4a34-ba10-e43bc1e0087d",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3040,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Assemble the month-by-month usage report.\nconst cfg = $('Config').first().json;\nconst names = {};\nfor (const it of $input.all()) {\n  const b = it.json;\n  if (b && b.ok && b.user) {\n    const p = b.user.profile || {};\n    names[b.user.id] = p.display_name || p.real_name || b.user.real_name || b.user.name;\n  }\n}\nconst months = {};\nconst totalUsers = {};\nconst totalThreads = {};\nlet total = 0;\nfor (const it of $('Dedupe Messages').all()) {\n  const m = it.json;\n  if (!months[m.month]) months[m.month] = { users: {}, messages: 0, threads: {} };\n  months[m.month].users[m.user] = (months[m.month].users[m.user] || 0) + 1;\n  months[m.month].messages += 1;\n  months[m.month].threads[m.thread_key] = true;\n  totalUsers[m.user] = true;\n  totalThreads[m.thread_key] = true;\n  total += 1;\n}\nconst gaps = [];\nfor (const it of $('List Conversations').all()) {\n  const b = it.json;\n  if (b && b.ok === false) gaps.push(b.needed || b.error || 'unknown');\n}\nconst monthRows = Object.keys(months).sort().map(mo => ({\n  month: mo,\n  distinct_users: Object.keys(months[mo].users).length,\n  messages: months[mo].messages,\n  threads: Object.keys(months[mo].threads).length,\n  users: Object.entries(months[mo].users).sort((a, b) => b[1] - a[1]).map(e => ({ user: e[0], name: names[e[0]] || e[0], messages: e[1] }))\n}));\nreturn [{ json: {\n  env: cfg.env,\n  since: cfg.since,\n  excluded_channels: cfg.excluded,\n  scope_gaps: gaps,\n  months: monthRows,\n  totals: { distinct_users: Object.keys(totalUsers).length, messages: total, threads: Object.keys(totalThreads).length },\n  generated_at: new Date().toISOString()\n} }];"
      }
    }
  ],
