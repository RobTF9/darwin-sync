    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM darwin_research_alerts\nWHERE\n  CASE\n    WHEN frequency = 'daily' THEN last_run IS NULL OR last_run::date < CURRENT_DATE\n    WHEN frequency = 'weekly' THEN (last_run IS NULL OR last_run::date < CURRENT_DATE) AND EXTRACT(dow FROM CURRENT_DATE) = 1\n    WHEN frequency = 'monthly' THEN (last_run IS NULL OR last_run::date < CURRENT_DATE) AND EXTRACT(day FROM CURRENT_DATE) = 1\n    ELSE false\n  END\nORDER BY created_at ASC;",
        "options": {}
      },
      "id": "95f646c4-f2d6-4fc2-a1e0-6236ac779401",
      "name": "Query Due Alerts",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.7,
      "position": [
        232,
        632
      ],
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const alerts = $input.all().map(i => i.json).filter(a => a && a.id);\n\nconst periodTextMap = { daily: '24 hours', weekly: '7 days', monthly: '30 days' };\n\nconst dueAlerts = [];\nfor (const alert of alerts) {\n  const periodText = periodTextMap[alert.frequency] || '24 hours';\n  const message = `🔔 Research Alert: ${alert.topic}\\n\\n<@U0BLRFB0FJR> Please search for user research sessions from the past ${periodText} that mention \"${alert.topic}\" and provide a concise summary of the key findings and insights.`;\n  dueAlerts.push({ json: { id: alert.id, channel: alert.channel, message } });\n}\n\nif (dueAlerts.length === 0) return [{ json: { no_alerts: true } }];\nreturn dueAlerts;"
      },
      "id": "f87d4ef7-79f5-4522-b674-d3d131f8b760",
