        "operation": "executeQuery",
        "query": "INSERT INTO darwin_research_alerts (id, topic, frequency, channel, requested_by, created_at, last_run)\nVALUES (\n  '{{ Date.now().toString() }}',\n  '{{ $json.body.topic }}',\n  '{{ $json.body.frequency }}',\n  '{{ $json.body.channel }}',\n  '{{ $json.body.requested_by }}',\n  '{{ new Date().toISOString() }}',\n  NULL\n)\nRETURNING *;",
