        "jsCode": "const f = $('Input').first().json;\nlet rows = $input.all().map((i) => i.json);\nif (f.case_id) rows = rows.filter((r) => r.case_id === f.case_id);\nif (f.run_id) rows = rows.filter((r) => r.run_id === f.run_id);\nrows = rows.slice(0, 100);\nreturn [{ json: { count: rows.length, rows } }];"
