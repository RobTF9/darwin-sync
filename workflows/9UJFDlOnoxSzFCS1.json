    {
      "parameters": {
        "jsCode": "// Build Slack Block Kit markdown blocks from the agent's raw markdown output.\n// Structure-aware chunking — tables and code fences are never sawn in half:\n//   - A table that fits in the current block is kept whole; if it fits in a\n//     fresh block it moves there; only longer tables split, always at a row\n//     boundary with the header + separator repeated at the top of the next\n//     block, so every block renders as a complete table in Slack.\n//   - Malformed tables (missing |---| separator, heading text glued onto the\n//     first row) are repaired before chunking.\n//   - Code fences that must split are closed at the chunk end and reopened\n//     at the start of the next chunk.\n// Each block stays under Slack's 3,000-char markdown limit, the serialized\n// payload stays under ~90KB, and there is a hard cap of 50 blocks.\n\nconst PER_BLOCK = 2900;  // leave margin under Slack's 3000-char limit\nconst MAX_BLOCKS = 50;   // hard cap: Slack max 50 blocks\nconst MAX_PAYLOAD_BYTES = 90000;  // ~90KB budget for serialized { blocks: [...] }\nconst TRUNCATION_NOTE = '\\n\\n_… (truncated: response too long for a single Slack message)_';\n\nlet text = $json.output ?? '';\nconst fullText = text;  // preserve original for downstream use\n\n// ---------------------------------------------------------------------------\n// Line classification helpers\n// ---------------------------------------------------------------------------\n\nfunction isFenceLine(line) {\n  return line.trimStart().startsWith('```');\n}\n\nfunction isTableRow(line) {\n  return line.trimStart().startsWith('|');\n}\n\nfunction isSeparatorRow(line) {\n  const t = line.trim();\n  return t.startsWith('|') && t.includes('-') && /^[\\s|:=-]+$/.test(t);\n}\n\nfunction countColumns(row) {\n  const t = row.trim().replace(/^\\|/, '').replace(/\\|\\s*$/, '');\n  return t ? t.split('|').length : 1;\n}\n\nfunction makeSeparator(nCols) {\n  return '|' + ' --- |'.repeat(Math.max(1, nCols));\n}\n\n// \"Heading text | a | b |\" -> [\"Heading text\", \"| a | b |\"], else null.\n// Splits prose that got glued onto a table's first row onto its own line.\nfunction splitGluedPrefix(line) {\n  if (isTableRow(line)) return null;\n  const m = line.match(/^(.*?\\S)\\s+(\\|\\s*\\S.*\\|\\s*)$/);\n  return m ? [m[1], m[2]] : null;\n}\n\n// ---------------------------------------------------------------------------\n// Pass 1: segment into text / table / fence runs, repairing tables\n// ---------------------------------------------------------------------------\n\nfunction segment(input) {\n  const lines = input.split('\\n');\n  const segs = [];\n  let textRun = [];\n  const flushText = () => {\n    if (textRun.length) { segs.push({ kind: 'text', lines: textRun }); textRun = []; }\n  };\n\n  let i = 0;\n  while (i < lines.length) {\n    const line = lines[i];\n\n    // Fenced code block — consume through the closing fence (or EOF)\n    if (isFenceLine(line)) {\n      flushText();\n      const fence = [line];\n      i++;\n      while (i < lines.length) {\n        fence.push(lines[i]);\n        const closes = isFenceLine(lines[i]);\n        i++;\n        if (closes) break;\n      }\n      segs.push({ kind: 'fence', lines: fence });\n      continue;\n    }\n\n    // Possible table start — a pipe row, or prose glued onto a pipe row\n    let prefix = null;\n    let row = line;\n    if (!isTableRow(line)) {\n      const parts = splitGluedPrefix(line);\n      if (parts) { prefix = parts[0]; row = parts[1]; }\n    }\n    if (isTableRow(row)) {\n      const rows = [row];\n      let j = i + 1;\n      while (j < lines.length && isTableRow(lines[j])) { rows.push(lines[j]); j++; }\n      if (rows.length >= 2) {\n        if (prefix !== null) textRun.push(prefix);\n        flushText();\n        // Repair: guarantee a separator row directly under the header\n        if (!isSeparatorRow(rows[1])) {\n          rows.splice(1, 0, makeSeparator(countColumns(rows[0])));\n        }\n        // Repair: guarantee trailing pipes on every row\n        const norm = rows.map(r => r.trimEnd().endsWith('|') ? r : r.trimEnd() + ' |');\n        segs.push({ kind: 'table', lines: norm });\n        i = j;\n        continue;\n      }\n      // Lone pipe line — not a table, fall through as text\n    }\n\n    textRun.push(line);\n    i++;\n  }\n  flushText();\n  return segs;\n}\n\n// ---------------------------------------------------------------------------\n// Pass 2: pack segments into chunks of at most PER_BLOCK chars\n// ---------------------------------------------------------------------------\n\nconst chunks = [];\nlet cur = [];\nlet curLen = 0;\n\nfunction joinedLen(lines) {\n  return lines.reduce((acc, l) => acc + l.length, 0) + Math.max(0, lines.length - 1);\n}\nfunction pushChunk() {\n  if (cur.length) { chunks.push(cur.join('\\n')); cur = []; curLen = 0; }\n}\nfunction addLine(line) {\n  curLen += (cur.length ? 1 : 0) + line.length;\n  cur.push(line);\n}\nfunction fits(len) {\n  return curLen + (cur.length ? 1 : 0) + len <= PER_BLOCK;\n}\n\n// Hard-slice an over-long line that can't fit any block (e.g. a giant URL)\nfunction addOversizedLine(line) {\n  while (line.length > 0) {\n    const room = PER_BLOCK - (curLen + (cur.length ? 1 : 0));\n    if (room <= 0) { pushChunk(); continue; }\n    addLine(line.slice(0, room));\n    line = line.slice(room);\n    if (line.length > 0) pushChunk();\n  }\n}\n\nfunction addTextSegment(lines) {\n  for (const line of lines) {\n    if (fits(line.length)) { addLine(line); continue; }\n    pushChunk();\n    if (line.length <= PER_BLOCK) addLine(line);\n    else addOversizedLine(line);\n  }\n}\n\nfunction addFenceSegment(lines) {\n  const closed = lines.length > 1 && isFenceLine(lines[lines.length - 1]);\n  const open = lines[0];\n  const body = closed ? lines.slice(1, -1) : lines.slice(1);\n  const close = closed ? lines[lines.length - 1] : null;\n\n  if (!fits(open.length)) pushChunk();\n  addLine(open);\n  for (const line of body) {\n    if (fits(line.length)) { addLine(line); continue; }\n    // Close the fence, break the chunk, reopen the fence in the next one\n    addLine('```');\n    pushChunk();\n    addLine(open);\n    if (fits(line.length)) addLine(line);\n    else addOversizedLine(line);\n  }\n  if (close !== null) {\n    if (!fits(close.length)) pushChunk();\n    addLine(close);\n  }\n}\n\nfunction addTableSegment(lines) {\n  const len = joinedLen(lines);\n  if (fits(len)) { lines.forEach(addLine); return; }\n  if (len <= PER_BLOCK) { pushChunk(); lines.forEach(addLine); return; }\n\n  // Table longer than one block: split at row boundaries, repeating the\n  // header + separator at the top of every continuation block.\n  const header = lines[0];\n  const separator = lines[1];\n  const rows = lines.slice(2);\n  if (cur.length) pushChunk();\n  addLine(header);\n  addLine(separator);\n  for (const row of rows) {\n    if (!fits(row.length)) {\n      pushChunk();\n      addLine(header);\n      addLine(separator);\n    }\n    if (fits(row.length)) addLine(row);\n    else addOversizedLine(row);  // pathological: single row wider than a block\n  }\n}\n\nfor (const seg of segment(text)) {\n  if (seg.kind === 'table') addTableSegment(seg.lines);\n  else if (seg.kind === 'fence') addFenceSegment(seg.lines);\n  else addTextSegment(seg.lines);\n}\npushChunk();\n\n// ---------------------------------------------------------------------------\n// Pass 3: enforce Slack's block-count and serialized-payload budgets\n// ---------------------------------------------------------------------------\n\nfunction toBlocks(arr) {\n  return arr.map(t => ({ type: 'markdown', text: t }));\n}\nfunction estimatePayloadSize(blocksArr) {\n  return JSON.stringify(blocksArr).length + 20;\n}\n\nlet outChunks = chunks.filter(c => c.trim().length > 0).slice(0, MAX_BLOCKS);\nlet overflow = chunks.length > MAX_BLOCKS;\nwhile (outChunks.length > 1 && estimatePayloadSize(toBlocks(outChunks)) > MAX_PAYLOAD_BYTES) {\n  outChunks.pop();\n  overflow = true;\n}\nif (overflow && outChunks.length) {\n  let last = outChunks[outChunks.length - 1];\n  const room = PER_BLOCK - TRUNCATION_NOTE.length;\n  if (last.length > room) last = last.slice(0, room);\n  outChunks[outChunks.length - 1] = last.replace(/\\n*$/, '') + TRUNCATION_NOTE;\n}\n\n// Never emit zero blocks — Slack rejects a message with an empty blocks\n// array; surface a visible fallback instead.\nif (outChunks.length === 0) outChunks = ['_Darwin returned an empty response._'];\n\nconst blocks = toBlocks(outChunks);\nconst content = { blocks };\n\nreturn [{ json: { blocksJson: JSON.stringify(content), output: fullText } }];"
      },
      "id": "3636feef-8692-4103-a639-e42fba425957",
      "name": "format",
