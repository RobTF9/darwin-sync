    {
      "parameters": {
        "jsCode": "const SUPPORTED = new Set(['text/csv','application/csv','application/json','text/plain','text/tab-separated-values','application/xml','text/xml','text/markdown','text/javascript','application/javascript']);\nconst ev = $('OnEvent').first().json.event || $('OnEvent').first().json;\nconst files = Array.isArray(ev.files) ? ev.files : [];\nconst supported = files.filter(f => f && SUPPORTED.has((f.mimetype || '').toLowerCase()) && (f.url_private_download || f.url_private));\nif (supported.length === 0) {\n  return [{ json: { noFiles: true } }];\n}\nreturn supported.map(f => ({ json: {\n  noFiles: false,\n  url_private_download: f.url_private_download || f.url_private,\n  filename: f.name || f.title || 'file',\n  mimetype: (f.mimetype || '').toLowerCase(),\n  size: typeof f.size === 'number' ? f.size : 0\n}}));"
