    {
      "parameters": {
        "jsCode": "const BOTS=['U09Q22R53T6','U0BLRFB0FJR'];\nconst mentionRe=new RegExp('<@('+BOTS.join('|')+')>\\\\s*','g');\nconst ev=$('OnEvent').first().json.event||$('OnEvent').first().json;\nconst triggerTs=ev.ts;\nconst channelId=ev.channel;\nconst sessionId=ev.ts;\nconst rawCurrent=(ev.text||'').replace(mentionRe,'').trim();\nconst msgs=$input.all().map(i=>i.json);\nconst prior=msgs.filter(m=>m && m.ts!==triggerTs && !BOTS.includes(m.user) && (m.bot_id?false:true));\nconst lines=prior.map(m=>{const who=m.user||m.username||'unknown';const txt=(m.text||'').replace(mentionRe,'').trim();return '['+who+']: '+txt;});\nconst context=['--- Thread context (previous messages) ---',...lines,'--- End thread context ---','','Current question: '+rawCurrent].join('\\n');\nreturn [{json:{chatInput:context,sessionId:sessionId,channelId:channelId}}];"
      },
