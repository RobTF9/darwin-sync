    {
      "parameters": {
        "jsCode": "const CAP = 51200;\nconst items = $input.all();\nconst parts = [];\nfor (const it of items) {\n  const meta = it.json || {};\n  let content = meta.data;\n  if (content == null) content = '';\n  if (typeof content !== 'string') { try { content = JSON.stringify(content); } catch (e) { content = String(content); } }\n  let truncated = false;\n  if (content.length > CAP) { content = content.slice(0, CAP); truncated = true; }\n  if (truncated) content = content + '\\n[...truncated at 50KB]';\n  const fname = meta.filename || 'file';\n  const mtype = meta.mimetype || 'application/octet-stream';\n  const size = typeof meta.size === 'number' ? meta.size : 0;\n  parts.push('[Attached file: ' + fname + '] (' + mtype + ', ' + size + ' bytes)\\n---\\n' + content + '\\n---\\n');\n}\nconst filePreamble = parts.join('\\n');\nreturn [{ json: { filePreamble } }];"
      },
