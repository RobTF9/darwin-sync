    {
      "id": "f7b172fc-cacc-4caf-ace7-40c3e0bb6379",
      "name": "Evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        80
      ],
      "parameters": {
        "jsCode": "const c = $('Load Case').first().json;\nconst inp = $('Input').first().json;\nconst ts = $('Session Ts').first().json.session_ts;\nconst botId = inp.bot_id || ($vars.env === 'production' ? 'U09Q22R53T6' : 'U0BLRFB0FJR');\nconst lastReact = $('Get Reactions').last().json;\nconst reactions = (lastReact.message && lastReact.message.reactions) || [];\nconst errored = reactions.some(r => r.name === 'x');\n\nconst seen = new Set();\nconst traceRows = $('Fetch Trace').all().map(i => i.json)\n  .filter(r => { if (r.id == null || seen.has(r.id)) return false; seen.add(r.id); return true; })\n  .sort((a, b) => a.id - b.id);\nconst replies = $('Fetch Thread').all().map(i => i.json);\nconst botMsgs = replies.filter(m => (m.user === botId || m.bot_id) && m.ts !== ts);\nconst slackAnswer = botMsgs.length ? String(botMsgs[botMsgs.length - 1].text || '') : '';\nconst traceAnswer = traceRows.length ? String(traceRows[traceRows.length - 1].output || '') : '';\nconst answer = traceAnswer || slackAnswer;\n\nlet status = 'ok';\nif (errored) status = 'error';\nelse if (!answer) status = 'error';\n\nconst norm = (s) => String(s).toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');\nconst calledN = [];\nfor (const row of traceRows) {\n  let steps = row.steps;\n  if (typeof steps === 'string') { try { steps = JSON.parse(steps); } catch (e) { steps = []; } }\n  if (!Array.isArray(steps)) steps = [];\n  for (const st of steps) {\n    if (!st || !st.tool) continue;\n    const n = norm(st.tool);\n    if (!calledN.includes(n)) calledN.push(n);\n  }\n}\n\nlet anchors = c.anchors;\nif (typeof anchors === 'string') { try { anchors = JSON.parse(anchors); } catch (e) { anchors = []; } }\nif (!Array.isArray(anchors)) anchors = [];\nconst results = [];\nif (status === 'ok') {\n  const answerN = answer.toLowerCase();\n  for (const a of anchors) {\n    let pass = false;\n    if (a.type === 'tool_called') pass = calledN.includes(norm(a.value));\n    else if (a.type === 'tool_not_called') pass = !calledN.includes(norm(a.value));\n    else if (a.type === 'contains') pass = answerN.includes(String(a.value).toLowerCase());\n    else if (a.type === 'not_contains') pass = !answerN.includes(String(a.value).toLowerCase());\n    if (!pass) status = 'anchor_fail';\n    results.push({ type: a.type, value: a.value, pass });\n  }\n}\n\nconst base = String($vars.instance_url || 'https://darwin-staging.app.n8n.cloud').replace(/\\/$/, '');\nreturn [{ json: {\n  run_id: inp.run_id,\n  case_id: inp.case_id,\n  attempt: Number(inp.attempt),\n  status: status,\n  agent_output: (answer || (errored ? 'agent errored (x reaction)' : 'timed out waiting for reply')).slice(0, 12000),\n  called_tools: calledN,\n  anchor_results: results,\n  session_id: ts,\n  execution_url: base + '/workflow/' + $workflow.id + '/executions/' + $execution.id\n} }];"
      }
    },
