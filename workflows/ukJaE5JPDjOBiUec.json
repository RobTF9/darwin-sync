    {
      "id": "03fa0f5d-1947-45c2-996a-b51343fbf79b",
      "name": "Check Done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "jsCode": "const reactions = ($json.message && $json.message.reactions) || [];\nconst done = reactions.some(r => r.name === 'white_check_mark' || r.name === 'x');\nlet prev = null;\ntry { prev = $('Check Done').item.json; } catch (e) { prev = null; }\nconst polls = prev ? (prev.polls || 0) + 1 : 1;\nreturn [{ json: { done: done, timedOut: !done && polls >= 24, polls: polls } }];"
      }
    },
