    {
      "id": "e166efc0-a782-4469-8e99-e76d8074b665",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3584,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "var unitRows = $(\"Fetch Unit Results\").all().map(function(i) { return i.json; });\nvar unitPass = unitRows.filter(function(r) { return r.status === \"pass\"; }).length;\nvar unitFail = unitRows.filter(function(r) { return r.status !== \"pass\"; });\nvar integRows = $(\"Fetch Integration Results\").all().map(function(i) { return i.json; });\nvar integPass = integRows.filter(function(r) { return r.status === \"pass\"; }).length;\nvar integFail = integRows.filter(function(r) { return r.status !== \"pass\"; });\nvar evalRows = $(\"Fetch Eval Results\").all().map(function(i) { return i.json; });\nvar evalPass = evalRows.filter(function(r) { return (r.verdict || r.status || \"\") === \"pass\"; }).length;\nvar evalFail = evalRows.filter(function(r) { return (r.verdict || r.status || \"\") === \"fail\"; });\nvar evalTotal = evalRows.length;\nvar chaosOk = false, chaosTotal = 0, chaosPass = 0, chaosSummary = \"\";\ntry {\n  var c = $(\"Run Chaos Tests\").first().json;\n  chaosOk = c.chaos_ok === true;\n  chaosTotal = Number(c.chaos_total) || 0;\n  chaosPass = Number(c.chaos_passed) || 0;\n  chaosSummary = String(c.chaos_summary || \"\");\n} catch (e) { chaosSummary = \"Error reading chaos results\"; }\nvar lines = [];\nlines.push(\"*Darwin nightly checks* — \" + new Date().toISOString().slice(0, 10));\nlines.push(\"\");\nif (unitRows.length) {\n  var icon = unitFail.length === 0 ? \"✅\" : \"❌\";\n  lines.push(\"*Unit:* \" + icon + \" \" + unitPass + \"/\" + unitRows.length + \" passed\");\n} else {\n  lines.push(\"*Unit:* ⚠️ no results\");\n}\nvar integTotal = integRows.length;\nif (integTotal) {\n  var icon2 = integFail.length === 0 ? \"✅\" : \"❌\";\n  lines.push(\"*Integration:* \" + icon2 + \" \" + integPass + \"/\" + integTotal + \" passed\");\n} else {\n  lines.push(\"*Integration:* ⚠️ no results\");\n}\nif (evalTotal) {\n  var evalIcon = evalFail.length === 0 ? \"✅\" : \"❌\";\n  lines.push(\"*Evals:* \" + evalIcon + \" \" + evalPass + \"/\" + evalTotal + \" passed\");\n} else {\n  lines.push(\"*Evals:* ⚠️ no results\");\n}\nif (chaosTotal) {\n  var chaosIcon = chaosOk ? \"✅\" : \"❌\";\n  lines.push(\"*Chaos (error handlers):* \" + chaosIcon + \" \" + chaosPass + \"/\" + chaosTotal + \" passed\");\n} else {\n  lines.push(\"*Chaos (error handlers):* ⚠️ skipped or errored\");\n}\nvar failures = [];\nfor (var i = 0; i < unitFail.length; i++) {\n  var r = unitFail[i];\n  failures.push(\"• [unit] \" + r.case_id + \" (\" + r.target + \"): \" + r.status + \" — \" + String(r.assertion_detail || \"\").slice(0, 200));\n}\nfor (var i = 0; i < integFail.length; i++) {\n  var r = integFail[i];\n  failures.push(\"• [integration] \" + r.case_id + \" (\" + r.target + \"): \" + r.status + \" — \" + String(r.assertion_detail || \"\").slice(0, 200));\n}\nfor (var i = 0; i < evalFail.length; i++) {\n  var r = evalFail[i];\n  var label = r.case_id || r.case || r.name || \"unknown\";\n  var score = r.score || r.overall_score || \"\";\n  failures.push(\"• [eval] \" + label + (score ? \" (score \" + Number(score).toFixed(2) + \")\" : \"\"));\n}\nif (!chaosOk && chaosTotal) {\n  failures.push(\"• [chaos] \" + chaosSummary);\n}\nif (failures.length) {\n  lines.push(\"\");\n  lines.push(\"*Failures*\");\n  for (var i = 0; i < failures.length; i++) lines.push(failures[i]);\n}\nreturn [{ json: { message: lines.join(\"\\n\"), failure_count: failures.length } }];"
      },
      "executeOnce": true
    },
