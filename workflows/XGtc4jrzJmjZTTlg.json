    {
      "parameters": {
        "jsCode": "var unitRows = $(\"Fetch Unit Results\").all().map(function(i) { return i.json; });\nvar unitPass = unitRows.filter(function(r) { return r.status === \"pass\"; }).length;\nvar unitFail = unitRows.filter(function(r) { return r.status !== \"pass\"; });\nvar integRows = $(\"Fetch Integration Results\").all().map(function(i) { return i.json; });\nvar integPass = integRows.filter(function(r) { return r.status === \"pass\"; }).length;\nvar integFail = integRows.filter(function(r) { return r.status !== \"pass\"; });\nvar evalRows = $(\"Fetch Eval Results\").all().map(function(i) { return i.json; });\nvar evalPass = evalRows.filter(function(r) { return r.status === \"pass\"; }).length;\nvar evalBorderline = evalRows.filter(function(r) { return r.status === \"borderline\"; }).length;\nvar evalFail = evalRows.filter(function(r) { return r.status === \"fail\"; });\nvar evalTotal = evalRows.length;\nfunction parseScore(r) {\n  try {\n    var s = typeof r.score === 'string' ? JSON.parse(r.score) : (r.score || {});\n    var dims = Object.keys(s).filter(function(k) { return k !== 'verdict'; });\n    if (!dims.length) return { avg: null, dims: {} };\n    var sum = 0;\n    for (var i = 0; i < dims.length; i++) { sum += Number(s[dims[i]]) || 0; }\n    return { avg: sum / dims.length, dims: s };\n  } catch (e) { return { avg: null, dims: {} }; }\n}\nvar chaosOk = false, chaosTotal = 0, chaosPass = 0, chaosSummary = \"\";\ntry { var c = $(\"Run Chaos Tests\").first().json; chaosOk = c.chaos_ok === true; chaosTotal = Number(c.chaos_total) || 0; chaosPass = Number(c.chaos_passed) || 0; chaosSummary = String(c.chaos_summary || \"\"); } catch (e) { chaosSummary = \"Error reading chaos results\"; }\nvar lines = [];\nlines.push(\"*Darwin nightly checks* \\u2014 \" + new Date().toISOString().slice(0, 10));\nlines.push(\"\");\nif (unitRows.length) { var icon = unitFail.length === 0 ? \"\\u2705\" : \"\\u274c\"; lines.push(\"*Unit:* \" + icon + \" \" + unitPass + \"/\" + unitRows.length + \" passed\"); } else { lines.push(\"*Unit:* \\u26a0\\ufe0f no results\"); }\nvar integTotal = integRows.length;\nif (integTotal) { var icon2 = integFail.length === 0 ? \"\\u2705\" : \"\\u274c\"; lines.push(\"*Integration:* \" + icon2 + \" \" + integPass + \"/\" + integTotal + \" passed\"); } else { lines.push(\"*Integration:* \\u26a0\\ufe0f no results\"); }\nif (evalTotal) { var evalIcon = evalFail.length === 0 && evalBorderline === 0 ? \"\\u2705\" : \"\\u274c\"; lines.push(\"*Evals:* \" + evalIcon + \" \" + evalPass + \" pass / \" + evalBorderline + \" borderline / \" + evalFail.length + \" fail (\" + evalTotal + \" total)\"); } else { lines.push(\"*Evals:* \\u26a0\\ufe0f no results\"); }\nif (chaosTotal) { var chaosIcon = chaosOk ? \"\\u2705\" : \"\\u274c\"; lines.push(\"*Chaos (error handlers):* \" + chaosIcon + \" \" + chaosPass + \"/\" + chaosTotal + \" passed\"); } else { lines.push(\"*Chaos (error handlers):* \\u26a0\\ufe0f skipped or errored\"); }\nvar failures = [];\nfor (var i = 0; i < unitFail.length; i++) { var r = unitFail[i]; failures.push(\"\\u2022 [unit] \" + r.case_id + \" (\" + r.target + \"): \" + r.status + \" \\u2014 \" + String(r.assertion_detail || \"\").slice(0, 200)); }\nfor (var i = 0; i < integFail.length; i++) { var r = integFail[i]; failures.push(\"\\u2022 [integration] \" + r.case_id + \" (\" + r.target + \"): \" + r.status + \" \\u2014 \" + String(r.assertion_detail || \"\").slice(0, 200)); }\nfor (var i = 0; i < evalFail.length; i++) { var r = evalFail[i]; var label = r.case_id || \"unknown\"; var ps = parseScore(r); var scoreText = ps.avg !== null ? \" (avg \" + ps.avg.toFixed(2) + \")\" : \"\"; failures.push(\"\\u2022 [eval] \" + label + \": \" + r.status + scoreText); }\nif (!chaosOk && chaosTotal) { failures.push(\"\\u2022 [chaos] \" + chaosSummary); }\nif (failures.length) { lines.push(\"\"); lines.push(\"*Failures*\"); for (var i = 0; i < failures.length; i++) lines.push(failures[i]); }\nreturn [{ json: { message: lines.join(\"\\n\"), failure_count: failures.length } }];"
      },
