        "jsCode": "var evalRunId = String($(\"Run Eval Suite\").first().json.run_id || \"\");\nvar evalExpected = parseInt($(\"Run Eval Suite\").first().json.case_count, 10) || 0;\nvar pollCount = ($runIndex || 0) + 1;\nvar evalRows = $(\"Poll Eval Results\").all().map(function(i) { return i.json; });\nvar evalMatching = evalRows.filter(function(r) { return String(r.run_id) === evalRunId; });\nvar evalCount = evalMatching.length;\nvar evalComplete = evalCount >= evalExpected;\nvar timeout = pollCount >= 20;\nreturn [{ json: { eval_run_id: evalRunId, eval_expected: evalExpected, eval_count: evalCount, eval_complete: evalComplete, all_complete: evalComplete, timeout: timeout, timed_out: timeout && !evalComplete } }];"
