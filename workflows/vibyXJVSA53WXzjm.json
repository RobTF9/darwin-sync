    {
      "id": "2e22b439-b9e7-4e8e-850d-cdb17b311ea1",
      "name": "Evaluate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const c = $('Load Case').first().json;\nconst inp = $('Input').first().json;\nconst r = $input.first().json;\nlet status = 'ok';\nlet answer = '';\nconst called = [];\nif (r && r.error) {\n  status = 'error';\n  answer = typeof r.error === 'string' ? r.error : JSON.stringify(r.error);\n} else {\n  if (typeof r.output === 'string') answer = r.output;\n  else if (r.output !== undefined) answer = JSON.stringify(r.output);\n  else answer = JSON.stringify(r);\n  if (Array.isArray(r.intermediateSteps)) {\n    for (const s of r.intermediateSteps) {\n      const t = s && s.action && s.action.tool;\n      if (t) called.push(t);\n    }\n  }\n  if (!answer) status = 'error';\n}\nconst norm = (s) => String(s).toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');\nconst calledN = [];\nfor (const t of called) { const n = norm(t); if (!calledN.includes(n)) calledN.push(n); }\nlet anchors = c.anchors;\nif (typeof anchors === 'string') { try { anchors = JSON.parse(anchors); } catch (e) { anchors = []; } }\nif (!Array.isArray(anchors)) anchors = [];\nconst results = [];\nif (status === 'ok') {\n  const answerN = answer.toLowerCase();\n  for (const a of anchors) {\n    let pass = false;\n    if (a.type === 'tool_called') pass = calledN.includes(norm(a.value));\n    else if (a.type === 'tool_not_called') pass = !calledN.includes(norm(a.value));\n    else if (a.type === 'contains') pass = answerN.includes(String(a.value).toLowerCase());\n    else if (a.type === 'not_contains') pass = !answerN.includes(String(a.value).toLowerCase());\n    if (!pass) status = 'anchor_fail';\n    results.push({ type: a.type, value: a.value, pass });\n  }\n}\nconst base = String($vars.instance_url || 'https://darwin-staging.app.n8n.cloud').replace(/\\/$/, '');\nreturn [{ json: {\n  run_id: inp.run_id,\n  case_id: inp.case_id,\n  attempt: Number(inp.attempt),\n  status: status,\n  agent_output: answer.slice(0, 12000),\n  called_tools: calledN,\n  anchor_results: results,\n  execution_url: base + '/workflow/' + $workflow.id + '/executions/' + $execution.id\n} }];"
      }
    },
