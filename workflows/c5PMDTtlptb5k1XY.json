    {
      "parameters": {
        "jsCode": "const raw=$input.all().map(i=>i.json);\nconst suites=raw.map(r=>{\n const valid=Array.isArray(r.results)&&r.results.length>0&&r.results.every(s=>Array.isArray(s.checks)&&s.checks.length>0&&s.checks.every(c=>['PASS','FAIL'].includes(c.status)));\n if(!valid||r.error)return {suite:r.suite||'UXR Search',status:'ERROR',error:r.error||'Missing or malformed suite report',report:r};\n const assertions=r.results.flatMap(s=>s.checks);\n const failed=r.results.filter(s=>s.checks.some(c=>c.status==='FAIL')).length;\n return {suite:r.suite,status:failed?'FAIL':'PASS',scenarios:r.results.length,failedScenarios:failed,assertions:assertions.length,failedAssertions:assertions.filter(c=>c.status==='FAIL').length,report:r};\n});\nreturn [{json:{suite:'UXR Tests - Run All',runAt:new Date().toISOString(),status:suites.length===3&&suites.every(s=>s.status==='PASS')?'PASS':'FAIL',totalSuites:suites.length,passedSuites:suites.filter(s=>s.status==='PASS').length,failedSuites:suites.filter(s=>s.status!=='PASS').length + Math.max(0,3-suites.length),totalScenarios:suites.reduce((n,s)=>n+(s.scenarios||0),0),totalAssertions:suites.reduce((n,s)=>n+(s.assertions||0),0),suites}}];"
      },
      "id": "ee77170b-f495-466c-94a3-7e62a3deb17a",
      "name": "All Tests Report",
      "type": "n8n-nodes-base.code",
