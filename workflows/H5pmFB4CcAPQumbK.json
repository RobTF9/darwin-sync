    {
      "parameters": {
        "jsCode": "const results = $('Fetch Results').all();\nconst question = $('Generate Run ID').first().json.question;\nconst run_id = $('Generate Run ID').first().json.run_id;\n\n// Clean up poll counter from static data\nconst staticData = $getWorkflowStaticData('global');\ndelete staticData[`pollCount_${run_id}`];\n\nconst completed = results.filter(r => r.json.status === 'complete');\nconst errors = results.filter(r => r.json.status === 'error');\nconst relevant = completed.filter(r => {\n  const resp = typeof r.json.response === 'string' ? JSON.parse(r.json.response) : r.json.response;\n  return resp && resp.relevant === true;\n});\n\nreturn [{\n  json: {\n    run_id,\n    question,\n    total_sessions: results.length,\n    completed: completed.length,\n    errors: errors.length,\n    relevant_sessions: relevant.length,\n    results: results.map(r => {\n      const resp = typeof r.json.response === 'string' ? JSON.parse(r.json.response) : r.json.response;\n      return {\n        session_id: r.json.session_id,\n        status: r.json.status,\n        response: resp\n      };\n    })\n  }\n}];"
      },
      "id": "4947f7c7-ddc1-4ceb-8d58-b72d4b11de16",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2912,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst runId = $('Generate Run ID').first().json.run_id;\n\n// Use run_id-scoped key so concurrent runs don't collide\nconst key = `pollCount_${runId}`;\nconst prevCount = staticData[key] || 0;\nconst newCount = prevCount + 1;\nstaticData[key] = newCount;\n\nreturn [{ \n  json: { \n    _pollCount: newCount, \n    run_id: runId, \n    question: $('Generate Run ID').first().json.question \n  } \n}];"
      },
      "id": "62d57036-e688-48fa-b894-f7608d39586f",
      "name": "Increment Poll Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        384
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $json._pollCount }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 150
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "697131ac-9dce-4f07-9578-42dfe511ce6e",
      "name": "Check Timeout?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1792,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const runId = $('Generate Run ID').first().json.run_id;\nconst question = $('Generate Run ID').first().json.question;\n\n// Clean up poll counter\nconst staticData = $getWorkflowStaticData('global');\ndelete staticData[`pollCount_${runId}`];\n\nreturn [{\n  json: {\n    run_id: runId,\n    question,\n    error: 'Polling timed out after 25 minutes. Some sessions may still be processing.',\n    timed_out: true\n  }\n}];\n"
      },
      "id": "77c3093b-8d91-428c-b03f-83296fdb15a7",
      "name": "Timeout Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        400
      ]
    },
    {
      "id": "1a7ca3e0-5b52-4a75-9185-15b20f524ac7",
      "name": "Filter Sessions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        384
      ],
      "parameters": {
        "jsCode": "const rows = $('Fetch Sessions').all();\nconst raw = $('Generate Run ID').first().json.include_unapproved;\nconst truthy = raw === true || ['true','yes','1'].includes(String(raw ?? '').trim().toLowerCase());\n\n// Conditionally drop unapproved rows unless include_unapproved is truthy\nconst selected = truthy ? rows : rows.filter(r => r.json.approved === true || r.json.approved === 'true');\n\nconst totalFetched = rows.length;\nconst dispatchedCount = selected.length;\nconst emptyTranscriptIds = selected\n  .filter(r => r.json.transcript === null || r.json.transcript === undefined || String(r.json.transcript).trim() === '')\n  .map(r => r.json.id);\n\nconsole.log(`[SessionQuestion] include_unapproved=${truthy} totalFetched=${totalFetched} dispatched=${dispatchedCount} emptyTranscript=${emptyTranscriptIds.length}`);\nif (emptyTranscriptIds.length) {\n  console.warn(`[SessionQuestion] sessions with empty/null transcript: ${emptyTranscriptIds.join(', ')}`);\n}\n\nreturn selected.map(r => ({\n  json: {\n    ...r.json,\n    _totalFetched: totalFetched,\n    _dispatchedCount: dispatchedCount,\n    _hasTranscript: !(r.json.transcript === null || r.json.transcript === undefined || String(r.json.transcript).trim() === ''),\n    _emptyTranscriptCount: emptyTranscriptIds.length\n  }\n}));\n"
      }
    },
