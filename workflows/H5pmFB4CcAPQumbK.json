        "jsCode": "const sessions = $('Filter Sessions').all();\nconst { run_id, question } = $('Generate Run ID').first().json;\n\nreturn sessions.map(s => ({\n  json: {\n    run_id,\n    session_id: s.json.id,\n    question,\n    status: 'pending'\n  }\n}));"
