      "id": "b5c53a73-e47f-4108-9fbc-f76589f91f43",
      "name": "Fetch Results",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2688,
        384
      ],
      "credentials": {
        "supabaseApi": {
          "id": "gBIPPKjo4dshypxE",
          "name": "Supabase API"
        }
