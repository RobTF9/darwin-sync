    {
      "parameters": {
        "operation": "getAll",
        "tableId": "session_question",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "run_id",
              "condition": "eq",
              "keyValue": "={{ $('Generate Run ID').first().json.run_id }}"
            }
          ]
        }
