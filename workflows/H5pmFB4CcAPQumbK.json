      "parameters": {
        "jsCode": "const sessions = $('Filter Sessions').all();\nconst trackingRows = $('Insert Tracking Rows').all();\nconst { question } = $('Generate Run ID').first().json;\n\nreturn sessions.map((s, i) => ({\n  json: {\n    question,\n    session_id: s.json.id,\n    row_id: trackingRows[i].json.id,\n    participant_name: s.json.participant_name || '',\n    role: s.json.role || '',\n    company_type: s.json.company_type || '',\n    ai_usage: s.json.ai_usage || '',\n    technical_ability: s.json.technical_ability || '',\n    persona: s.json.persona || '',\n    profile_summary: s.json.profile_summary || '',\n    session_summary: s.json.session_summary || '',\n    transcript: s.json.transcript || '',\n    using_n8n_for: s.json.using_n8n_for || ''\n  }\n}));"
      },
