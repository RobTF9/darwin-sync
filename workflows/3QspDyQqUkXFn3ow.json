    {
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const r = item.json;\n  const meta = Array.isArray(r.metaData) ? (r.metaData[0] || {}) : (r.metaData || {});\n  const content = Array.isArray(r.content) ? (r.content[0] || {}) : (r.content || {});\n  const parties = r.parties || [];\n  const transcript = r.transcript || [];\n\n  // Build anonymized speaker map: speakerId -> \"Speaker N (Affiliation)\"\n  // N is 1-indexed by array position; Affiliation from parties[i].affiliation.\n  const speakerLabels = {};   // keyed by speakerId\n  const nameToLabel = {};      // real name -> label, for scrubbing summary text\n  parties.forEach((p, i) => {\n    const affiliation = p.affiliation || 'Unknown';\n    const label = 'Speaker ' + (i + 1) + ' (' + affiliation + ')';\n    if (p.speakerId !== undefined && p.speakerId !== null) {\n      speakerLabels[p.speakerId] = label;\n    }\n    if (p.name) {\n      nameToLabel[p.name] = label;\n    }\n  });\n\n  // Helper: replace any real participant name occurrences with the anon label.\n  const scrub = (text) => {\n    if (!text) return text;\n    let out = String(text);\n    for (const [name, label] of Object.entries(nameToLabel)) {\n      if (!name) continue;\n      const escaped = name.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n      out = out.replace(new RegExp(escaped, 'g'), label);\n    }\n    return out;\n  };\n\n  // Participants line uses anonymized labels only (no names/emails).\n  const participantLabels = parties.map((p, i) => 'Speaker ' + (i + 1) + ' (' + (p.affiliation || 'Unknown') + ')');\n\n  const keyPointsText = (content.keyPoints || []).map(k => \"- \" + (k.text || \"\")).join(\"\\n\");\n\n  const outlineText = (content.outline || []).map(s => {\n    const items = (s.items || []).map(i => \"  - \" + (i.text || \"\")).join(\"\\n\");\n    return \"### \" + (s.section || \"\") + \"\\n\" + items;\n  }).join(\"\\n\\n\");\n\n  const highlightsText = (content.highlights || []).map(h => {\n    const items = (h.items || []).map(i => \"  - \" + (i.text || \"\")).join(\"\\n\");\n    return \"### \" + (h.title || \"\") + \"\\n\" + items;\n  }).join(\"\\n\\n\");\n\n  const trackersText = (content.trackers || [])\n    .filter(t => Number(t.count) > 0)\n    .map(t => t.name + \" (\" + t.count + \")\")\n    .join(\", \");\n\n  const summaryParts = [\n    \"# \" + (meta.title || \"Untitled call\"),\n    \"Date: \" + r.scheduled_at,\n    \"Participants: \" + participantLabels.join(\", \"),\n  ];\n  if (meta.url) summaryParts.push(\"URL: \" + meta.url);\n  summaryParts.push(\"\", \"## Brief\", content.brief || \"\");\n  if (keyPointsText) summaryParts.push(\"\", \"## Key Points\", keyPointsText);\n  if (outlineText) summaryParts.push(\"\", \"## Outline\", outlineText);\n  if (highlightsText) summaryParts.push(\"\", \"## Highlights\", highlightsText);\n  if (trackersText) summaryParts.push(\"\", \"## Trackers triggered\", trackersText);\n  const summaryText = scrub(summaryParts.join(\"\\n\"));\n\n  const transcriptText = transcript.map(turn => {\n    const speaker = speakerLabels[turn.speakerId] || (\"Speaker \" + turn.speakerId);\n    const sentences = (turn.sentences || []).map(s => s.text).join(\" \");\n    const topic = turn.topic ? \" [\" + turn.topic + \"]\" : \"\";\n    return speaker + topic + \": \" + sentences;\n  }).join(\"\\n\\n\");\n\n  return {\n    json: {\n      call_id: r.call_id,\n      scheduled_at: r.scheduled_at,\n      primary_user_id: r.primary_user_id || null,\n      meeting_system: r.meeting_system || null,\n      title: meta.title || \"\",\n      duration: meta.duration ? Number(meta.duration) : null,\n      url: meta.url || \"\",\n      embed_url_base: `https://us-29262.app.gong.io/embedded-call?call-id=${r.call_id}`,\n      summary_text: summaryText,\n      transcript_text: transcriptText,\n    }\n  };\n});"
      },
      "id": "20fc4f6b-7c71-4ad9-95ff-0fceaaf72b02",
