    {
      "parameters": {
        "jsCode": "const j = $('Prepare Calls').item.json;\nconst out = [];\n\n// Extract clean date from scheduled_at\nconst date = j.scheduled_at ? j.scheduled_at.substring(0, 10) : null;\n\nout.push({\n  json: {\n    call_id: j.call_id,\n    scheduled_at: j.scheduled_at,\n    date: date,\n    primary_user_id: j.primary_user_id,\n    meeting_system: j.meeting_system,\n    title: j.title,\n    url: j.url,\n    embed_url_base: j.embed_url_base,\n    doc_type: \"summary\",\n    content: j.summary_text,\n  }\n});\n\nif (j.transcript_text && j.transcript_text.trim().length > 0) {\n  out.push({\n    json: {\n      call_id: j.call_id,\n      scheduled_at: j.scheduled_at,\n      date: date,\n      primary_user_id: j.primary_user_id,\n      meeting_system: j.meeting_system,\n      title: j.title,\n      url: j.url,\n      embed_url_base: j.embed_url_base,\n      doc_type: \"transcript\",\n      content: j.transcript_text,\n    }\n  });\n}\n\nreturn out;"
      },
