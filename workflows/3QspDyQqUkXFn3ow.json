      "parameters": {
        "jsCode": "const seen = new Set();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const blocks = item.json.blocks || [];\n  const tables = blocks.filter(b => b.type === 'table');\n\n  for (const table of tables) {\n    const rows = table.rows || [];\n    for (let i = 1; i < rows.length; i++) {\n      const row = rows[i];\n      const cell = (c) => {\n        try {\n          return (c?.elements || []).flatMap(el => (el?.elements || []).map(e => e.text || '')).join('');\n        } catch { return ''; }\n      };\n\n      const call_id = cell(row[0]).trim();\n      if (!call_id || seen.has(call_id)) continue;\n      seen.add(call_id);\n\n      results.push({\n        json: {\n          call_id,\n          title: cell(row[1]).trim(),\n          parties: cell(row[2]).trim(),\n          sync_status: cell(row[3]).trim(),\n          sync_time: cell(row[4]).trim(),\n        }\n      });\n    }\n  }\n}\n\nif (results.length === 0) {\n  return [{ json: { _empty: true } }];\n}\nreturn results;"
      },
