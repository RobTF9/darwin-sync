        }
      },
      "id": "ad2febba-04ee-407d-9a13-f5d138d4f313",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select p.id::text as project_id, p.name, p.closed_at::text as closed_at, (select count(*)::int from session s where s.project_id = p.id and s.transcript is not null) as sessions_total, (coalesce(length(p.script),0) > 0) as has_script, (select count(*)::int from question q where q.project_id = p.id and q.status = 'active' and q.section != 'emergent_candidate') as active_questions, exists(select 1 from project_analysis_run r where r.project_id = p.id and r.status = 'running') as run_in_progress from project p where (nullif($1,'') is not null and p.id::text = $1) or (nullif($1,'') is null and nullif($2,'') is not null and p.name ilike '%' || $2 || '%') limit 6",
        "options": {
          "queryReplacement": "={{ ($json.project_id || '').trim() }},{{ ($json.project_name || '').replace(/,/g, ' ').trim() }}"
        }
      },
      "id": "286aa527-9656-4540-a9a0-58c7f2d4bbcb",
      "name": "Find Projects",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const t = $('When Called').first().json;\nconst asked = (t.project_name || t.project_id || '').toString().trim();\nconst rows = $input.all().map(i => i.json).filter(r => r && r.project_id);\n\nfunction refuse(message) { return [{ json: { ok: false, message } }]; }\n\nif (rows.length === 0) {\n  return refuse(`No project found matching \"${asked}\". Ask the user for the exact project name.`);\n}\nlet chosen = null;\nif (rows.length === 1) {\n  chosen = rows[0];\n} else {\n  const exact = rows.filter(r => r.name.toLowerCase().trim() === (t.project_name || '').toLowerCase().trim());\n  if (exact.length === 1) {\n    chosen = exact[0];\n  } else {\n    const names = rows.map(r => r.name).join('; ');\n    return refuse(`Multiple projects match \"${asked}\": ${names}. Ask the user which one to close.`);\n  }\n}\nif (chosen.run_in_progress) {\n  return refuse(`An analysis for \"${chosen.name}\" is already running. Wait for it to finish before closing again.`);\n}\nif (!chosen.sessions_total) {\n  return refuse(`\"${chosen.name}\" has no sessions with transcripts, so there is nothing to analyse.`);\n}\nif (!chosen.active_questions && !chosen.has_script) {\n  return refuse(`\"${chosen.name}\" has no interview script and no parsed questions. Add a script to the project first.`);\n}\nreturn [{ json: { ok: true, project_id: chosen.project_id, name: chosen.name, sessions_total: chosen.sessions_total, previously_closed: !!chosen.closed_at } }];"
      },
