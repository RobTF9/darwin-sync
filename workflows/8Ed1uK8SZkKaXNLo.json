  "id": "8Ed1uK8SZkKaXNLo",
  "name": "ProjectClose",
  "description": "Darwin agent tool: closes a research project. Resolves the project, guards against duplicate runs, records a project_analysis_run row, fires ProjectAnalysisOrchestrator async, and returns immediately with a status message for the agent to relay.",
  "nodes": [
