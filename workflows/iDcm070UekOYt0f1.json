    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Same format step as the `format` Code node in the Slack workflow: wrap the\n// Builder agent's raw markdown diagnosis in a Block Kit markdown block — Slack\n// renders standard markdown natively (headers, tables, code fences, mentions).\n// Cumulative markdown-block limit is 12,000 chars per message.\nconst LIMIT = 12000;\nconst header = '*Builder diagnosis & suggested fix:*\\n';\nconst footer = '\\n\\n_Reply in this thread to continue the conversation with the Builder._';\nlet body = $json.output ?? '';\nconst budget = LIMIT - header.length - footer.length;\nif (body.length > budget) {\n  body = body.slice(0, budget - 120) + '\\n\\n_…truncated — reply exceeded Slack’s 12,000-character markdown block limit_';\n}\nconst text = header + body + footer;\n// blocksUi must be an object shaped { blocks: [...] } — a bare array spreads\n// into the request body without a `blocks` key, and Slack rejects\n// chat.postMessage with \"no_text\".\nconst content = { blocks: [{ type: 'markdown', text }] };\nreturn { json: { blocksJson: JSON.stringify(content), output: text } };"
      },
      "id": "602d071c-b6a6-4221-b46f-146a514779cb",
      "name": "format",
      "type": "n8n-nodes-base.code",
