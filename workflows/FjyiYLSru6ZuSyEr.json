{
  "id": "FjyiYLSru6ZuSyEr",
  "name": "UXR Calendly Booking Webhook",
  "description": null,
  "nodes": [
    {
      "parameters": {
        "content": "## UXR Calendly Booking\nCalendly organization webhook (invitee.created) -> this URL. Only bookings made through a wizard link count: Prepare Send appends utm_source=uxr_recruiting and utm_campaign=<batch_id> to the Calendly link, Calendly echoes them in payload.tracking.\n\nFlow: match the invitee email to the batch candidate -> status booked + booked_at -> booked_count +1 on the session -> :tada: message in the recruiting thread (skipped when the session has no thread).\n\nThe webhook subscription lives in Calendly (organization scope) and was created via the API with Giulio's PAT. Signing-key check: not implemented yet (staging).",
        "height": 300,
        "width": 520
      },
      "id": "490090f4-50ae-49a1-80d8-4b8fd521fa6a",
      "name": "Sticky Note d5d6072b",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        -368
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "uxr-calendly-booking",
        "options": {}
      },
      "id": "1ddd7b94-26e4-45e3-819d-e949cb1c5090",
      "name": "Calendly Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "63d30c16-435e-48ba-93c6-926e896a3029"
    },
    {
      "parameters": {
        "jsCode": "const cfg = ($('Load Config').first() || {}).json || {};\nconst utmSource = String(cfg.calendlyUtmSource || 'uxr_recruiting');\nconst b = $('Calendly Webhook').first().json.body || {};\nconst p = b.payload || {};\nconst t = p.tracking || {};\nconst ev = p.scheduled_event || {};\n// Only invitee.created bookings that came through a wizard link (utm_source = Config calendlyUtmSource, utm_campaign = <batch_id>)\nif (b.event !== 'invitee.created') return [];\nif (String(t.utm_source || '') !== utmSource || !t.utm_campaign) return [];\nreturn [{ json: {\n  batch_id: String(t.utm_campaign),\n  email: String(p.email || '').trim().toLowerCase(),\n  invitee_name: p.name || '',\n  event_name: ev.name || 'Research session',\n  start_time: ev.start_time || '',\n  booked_at: new Date().toISOString(),\n  invitee_uri: p.uri || ''\n} }];"
      },
      "id": "8e9e3f49-8df0-435d-9b7e-6276c9382ac4",
      "name": "Parse Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "kg4tyWXVPE6h5pH6",
          "cachedResultName": "UXR Recruiting - Candidates"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "batch_id",
              "keyValue": "={{ $json.batch_id }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "4450baa0-b245-425e-967e-c9658655643f",
      "name": "Get Batch Candidates",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const bk = $('Parse Booking').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.email);\nconst row = rows.find(r => String(r.email).trim().toLowerCase() === bk.email);\n// Unknown email for this batch (forwarded link, typo): nothing to update\nif (!row) return [];\nreturn [{ json: { ...bk, row_id: row.id, already_booked: row.status === 'booked' } }];"
      },
      "id": "067395bb-d83c-4301-891c-7c24406c7ca7",
      "name": "Match Candidate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
