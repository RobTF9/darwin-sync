    {
      "parameters": {
        "jsCode": "const b = $('Bump Booked Count').first().json;\n// Sessions created before 2026-09-22 14:00 lost channel/thread_ts (Handler bug): skip the Slack post, the tables are still updated\nif (!b.channel || !b.thread_ts) return [];\nreturn [{ json: b }];"
