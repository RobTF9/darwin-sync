      },
      "id": "cbdfa3b1-16c5-49b5-bb10-efadc5408f4c",
      "name": "Get Session By Batch",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1344,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const bk = $('Match Candidate').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.session_key);\nif (!rows.length) return [];\nconst s = rows[0];\nconst count = (Number(s.booked_count) || 0) + (bk.already_booked ? 0 : 1);\nconst when = bk.start_time ? new Date(bk.start_time).toUTCString().replace(':00 GMT', ' UTC') : 'a date to be confirmed';\nconst text = ':tada: *New booking!* `' + bk.email + '`' + (bk.invitee_name ? ' (' + bk.invitee_name + ')' : '') + ' booked *' + bk.event_name + '* for ' + when + '.\\n_' + count + ' booking' + (count === 1 ? '' : 's') + ' so far for batch `' + bk.batch_id + '`' + (s.requested_count ? ' (' + s.requested_count + ' invited)' : '') + '._';\nreturn [{ json: { session_key: s.session_key, booked_count: count, channel: s.channel || '', thread_ts: s.thread_ts || '', text } }];"
      },
      "id": "8816c555-c813-4a30-a2b0-1b82ee3dd37e",
