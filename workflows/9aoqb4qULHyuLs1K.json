    {
      "id": "dd794f22-75b5-430e-9822-0be04f2e02df",
      "name": "Filter Cases",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        768
      ],
      "parameters": {
        "jsCode": "const input = $('Input').item.json;\nconst category = String(input.category || '').trim();\nconst slug = String(input.slug || '').trim();\nreturn $input.all()\n  .map(i => i.json)\n  .filter(c => (!category || c.category === category) && (!slug || c.slug === slug))\n  .map(c => ({ json: c }));"
      }
    },
    {
      "id": "d1856a72-c6b8-404b-9a6f-648f0409dbdb",
      "name": "Load Results",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        304,
        448
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "retrieval_results",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "run_id",
              "condition": "eq",
              "keyValue": "={{ $('Run Id').first().json.run_id }}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "gjrMKYK5nCbL3TLf",
          "name": "Supabase Tests"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "383146ed-7fb2-4513-8194-bf64ab4b8fcb",
      "name": "Poll Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        368
      ],
      "parameters": {
        "jsCode": "const runId = $('Run Id').first().json.run_id;\nconst expected = $('Filter Cases').all().length;\nconst rows = $input.all().map(i => i.json).filter(r => r.run_id === runId);\nconst slugs = {};\nfor (const c of $('Filter Cases').all()) slugs[c.json.id] = c.json.slug;\nconst seen = new Set();\nconst unique = [];\nfor (const r of rows) {\n  if (!r.case_id || seen.has(r.case_id)) continue;\n  seen.add(r.case_id);\n  unique.push(r);\n}\nconst counts = { pending: 0, pass: 0, fail: 0, error: 0 };\nconst cases = unique.map(r => {\n  counts[r.status] = (counts[r.status] || 0) + 1;\n  return { slug: slugs[r.case_id] || r.case_id, status: r.status, called_tools: r.called_tools };\n});\ncases.sort((a, b) => (a.slug < b.slug ? -1 : 1));\nconst poll = ($runIndex || 0) + 1;\nreturn [{ json: {\n  run_id: runId,\n  expected: expected,\n  landed: unique.length,\n  polls: poll,\n  complete: unique.length >= expected,\n  timeout: poll >= 20,\n  pending: counts.pending,\n  pass: counts.pass,\n  fail: counts.fail,\n  error: counts.error,\n  cases: cases\n} }];"
      }
    },
    {
      "id": "af284154-e434-4f96-8d44-9e5fb40b5300",
      "name": "Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        752,
        368
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $json.complete }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "id": "cond-complete"
            },
            {
              "leftValue": "={{ $json.timeout }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "id": "cond-timeout"
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "29f39b71-3824-48f8-bbec-d85cd7b41fea",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        320
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst lines = [];\nlines.push('## `' + r.run_id + '`', '');\nlines.push('**' + (r.complete ? 'Complete' : 'Incomplete (timeout)') + '** · ' + r.landed + '/' + r.expected + ' cases landed · ' + r.polls + ' polls', '');\nlines.push('| Case | Status | Tools called |', '| --- | --- | --- |');\nfor (const c of r.cases) {\n  const tools = Array.isArray(c.called_tools) ? c.called_tools.join(', ') : '';\n  lines.push('| `' + c.slug + '` | ' + c.status + ' | ' + (tools || '—') + ' |');\n}\nlines.push('', 'Statuses are `pending` until scored locally with `pnpm evals:score-agent -- --run ' + r.run_id + '`.');\nreturn [{ json: {\n  markdown: lines.join('\\n'),\n  run_id: r.run_id,\n  expected: r.expected,\n  landed: r.landed,\n  complete: r.complete,\n  cases: r.cases\n} }];"
      }
    },
