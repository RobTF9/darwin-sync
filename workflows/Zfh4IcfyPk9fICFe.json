        "jsCode": "const t = $('Sub').first().json;\nconst esc = (s) => String(s).replace(/'/g, \"''\");\nif (!t.path) throw new Error('path is required — pass the `path` field from a search hit');\nconst w = Math.min(Number(t.window_secs) || 240, 900);\nconst m = Math.min(Number(t.max_items) || 20, 50);\nreturn { sql: \"select public.get_resource_context('\" + esc(t.path) + \"'::ltree, \" + w + \", \" + m + \") as context\" };"
