    {
      "id": "91b9a9f9-f565-4129-9303-32f746c38e4f",
      "name": "Answer Question",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        112
      ],
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=## Question\n{{ $json.question }}\n\n## Participant Profile\n- Name: {{ $json.participant_name }}\n- Role: {{ $json.role }}\n- Company Type: {{ $json.company_type }}\n- AI Usage: {{ $json.ai_usage }}\n- Technical Ability: {{ $json.technical_ability }}\n- Persona: {{ $json.persona }}\n- Using n8n for: {{ $json.using_n8n_for }}\n\n## Profile Summary\n{{ $json.profile_summary }}\n\n## Session Summary\n{{ $json.session_summary }}\n\n## Full Transcript\n{{ $json.transcript }}",
        "options": {
          "systemMessage": "You are a research analyst. You will be given context about a research session participant and their full interview transcript. Answer the question based ONLY on evidence from this session. \n\nRespond in JSON format:\n{\n  \"answer\": \"Your concise answer based on evidence from this session\",\n  \"reasoning\": \"The evidence and quotes from the transcript that support your answer\",\n  \"relevant\": true/false  // whether this session contains relevant information for the question\n}\n\nIf the session does not contain relevant information for the question, set relevant to false and explain why in the reasoning.",
          "maxIterations": 3
        },
        "needsFallback": false
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "763f25c7-418d-40d4-9280-ccda485bd9d7",
      "name": "Answer Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        368,
        336
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"answer\": \"Your concise answer based on evidence from this session\", \"reasoning\": \"The evidence and quotes from the transcript that support your answer\", \"relevant\": true }",
        "autoFix": true
      }
    },
    {
      "id": "79230bc8-2764-4337-8e53-0e62294499cc",
      "name": "Update Error",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        576,
        208
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "session_question",
