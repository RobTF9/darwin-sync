      "parameters": {}
    },
    {
      "id": "4a10e19e-b269-413d-984a-4e2732460c16",
      "name": "Sticky Note 5fd24288",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        512,
        224
      ],
      "parameters": {
        "content": "## PF Show-up Check\nEvery 5 minutes: finds sessions that are `active`, `pending`, started at least `askDelayMinutes` ago (mock 1, real 15) and not more than 6 h ago.\n\nClaims each one (`pending` to `asked`) so two runs cannot ask twice, then starts **PF Session Follow-up** without waiting.\n\n**Not published.** Publishing needs a yes from Aniol (DWN-6 gate). Use **Run Check Now** until then.",
        "color": 5
      }
    },
    {
      "id": "363c21d2-5f8f-4a20-a9a6-8fb69fcbfcdb",
      "name": "Claim Due Sessions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        608,
        224
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Select and claim in one statement, so two runs can never ask about the same session.\n-- $3: comma-separated host emails to include; empty = all hosts.\nUPDATE calendar_research_sessions\nSET followup_status = 'asked',\n    showup_asked_at = now(),\n    updated_at = now()\nWHERE id IN (\n  SELECT id FROM calendar_research_sessions\n  WHERE booking_status = 'active'\n    AND followup_status = 'pending'\n    AND invitee_uri IS NOT NULL\n    AND starts_at <= now() - make_interval(mins => $1::int)\n    AND starts_at >= now() - make_interval(hours => $2::int)\n    AND ($3 = '' OR lower(organizer_email) = ANY(string_to_array($3, ',')))\n  FOR UPDATE SKIP LOCKED\n)\nAND followup_status = 'pending'\nRETURNING id, invitee_uri;",
        "options": {
          "queryReplacement": "={{ [ String($('Load Config').first().json.askDelayMinutes), String($('Load Config').first().json.showupWindowHours), ($('Load Config').first().json.hostAllowList || []).join(',') ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "id": "5c83fefa-5278-4a18-8f21-e49883970abe",
      "name": "Has Session?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        720,
        224
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.invitee_uri ?? '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "The Postgres node outputs one {success: true} item when no session is due. Only claimed sessions (with invitee_uri) continue."
    }
  ],
