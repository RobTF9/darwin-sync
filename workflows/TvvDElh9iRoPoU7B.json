    },
    {
      "parameters": {
        "jsCode": "// Filter the BigQuery row down to a PII-safe payload for the agent.\nconst items = $input.all();\nif (items.length === 0) {\n  return [{ json: { error: 'No call found for the given call_id.' } }];\n}\n\nconst r = items[0].json;\nconst meta = Array.isArray(r.metaData) ? (r.metaData[0] || {}) : (r.metaData || {});\nconst parties = Array.isArray(r.parties) ? r.parties : [];\n\n// Parties: keep ONLY speakerId and affiliation. Strip name/email/phone/all else.\nconst safeParties = parties.map((p) => ({\n  speakerId: p.speakerId ?? null,\n  affiliation: p.affiliation ?? null,\n}));\n\nreturn [{\n  json: {\n    call_id: r.call_id ?? null,\n    scheduled_at: r.scheduled_at ?? null,\n    meeting_system: r.meeting_system ?? null,\n    parties: safeParties,\n    content: r.content ?? null,\n    transcript: r.transcript ?? null,\n    title: meta.title ?? null,\n    duration: meta.duration ?? null,\n    url: meta.url ?? null,\n  }\n}];"
      },
      "id": "bb483661-ed67-44a4-8be5-12f656fe8f5f",
      "name": "Filter PII",
      "type": "n8n-nodes-base.code",
