      "id": "de68744d-06eb-4c0a-935a-25700bb2bf3d",
      "name": "Validate Send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json;\nconst batchId = (j.batch_id || '').toString().trim();\nconst body = (j.email_body || '').toString();\nconst calendly = (j.calendly_url || '').toString().trim();\nconst testMode = j.test_mode === true || j.test_mode === 'true';\nlet error = null;\nif (!batchId) error = 'Missing batch_id.';\nelse if (!body) error = 'Missing email_body.';\nelse if (body.indexOf('{{calendly_link}}') !== -1 && !calendly) error = 'The email body contains {{calendly_link}} but no calendly_url was provided. Refusing to send.';\nreturn [{ json: { valid: !error, error: error, batch_id: batchId, email_subject: (j.email_subject || 'Invitation: Help us improve n8n').toString(), email_body: body, calendly_url: calendly, test_mode: testMode } }];"
      }
