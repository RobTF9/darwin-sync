      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const chk = $('Check Send OK').first().json;\nconst inp = $input.first().json || {};\nlet ok = chk.send_ok === true;\nlet err = chk.error || null;\nif (ok && inp.statusCode !== undefined && inp.statusCode >= 400) {\n  ok = false;\n  err = 'Customer.io stamp failed (HTTP ' + inp.statusCode + ')';\n}\nreturn [{ json: { row_id: chk.row_id, email: chk.email, final_status: ok ? 'sent' : 'failed', error: err, sent_at: ok ? new Date().toISOString() : '' } }];"
      }
