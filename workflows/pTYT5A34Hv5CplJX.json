    {
      "id": "e779d721-358c-44c5-aef4-84d6496f6d56",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.email);\nconst sent = rows.filter(r => r.status === 'sent').length;\nconst failed = rows.filter(r => r.status === 'failed').length;\nconst details = rows.map(r => ({ email: r.email, status: r.status }));\nconst v = $('Validate Send').first().json;\nreturn [{ json: { success: failed === 0, sent: sent, failed: failed, test_mode: v.test_mode === true, batch_id: v.batch_id, details: details, message: 'Sent ' + sent + ', failed ' + failed + (v.test_mode ? ' (TEST MODE: recipients overridden, no Customer.io stamping)' : '') + '.' } }];"
      }
    },
