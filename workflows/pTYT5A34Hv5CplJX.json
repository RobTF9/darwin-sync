    {
      "id": "3c57736a-6e90-419c-b5d9-c806d24ea72d",
      "name": "Prepare Recipients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const v = $('Validate Send').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.email);\nlet list = rows;\nif (v.test_mode === true) list = rows.slice(0, 2);\nif (list.length === 0) return [{ json: { __none: true, batch_id: v.batch_id } }];\nreturn list.map(r => {\n  let body = v.email_body || '';\n  body = body.split('{{first_name}}').join(r.first_name || 'there');\n  body = body.split('{{calendly_link}}').join(v.calendly_url || '');\n  const recipient = v.test_mode === true ? 'design@n8n.io, g.andreini@gmail.com' : r.email;\n  return { json: { row_id: r.id, email: r.email, recipient: recipient, subject: v.email_subject, body: body, test_mode: v.test_mode === true } };\n});"
      }
    },
