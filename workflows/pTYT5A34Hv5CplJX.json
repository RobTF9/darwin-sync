        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const sent = $input.first().json || {};\nconst item = $('Send Loop').first().json;\nconst ok = !sent.error;\nreturn [{ json: { ...item, send_ok: ok, error: sent.error ? (typeof sent.error === 'string' ? sent.error : (sent.error.message || JSON.stringify(sent.error).slice(0, 200))) : null } }];"
