    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst triggerData = $('When Executed by Darwin').first().json;\n\nfunction parseMessage(raw) {\n  let msg = raw;\n  if (typeof msg === 'string') {\n    try { msg = JSON.parse(msg); } catch (e) { return null; }\n  }\n  if (!msg || typeof msg !== 'object') return null;\n  let role = msg.role || msg.type || (msg.data && msg.data.type);\n  let content = msg.content;\n  if (content === undefined && msg.data) content = msg.data.content;\n  if (role === 'human') role = 'user';\n  if (role === 'ai') role = 'assistant';\n  if (content === undefined || content === null) return null;\n  if (typeof content !== 'string') content = JSON.stringify(content);\n  return { role, content };\n}\n\nconst messages = [];\nfor (const r of rows) {\n  const parsed = parseMessage(r.message);\n  if (parsed) messages.push(parsed);\n}\n\nlet lastUserIdx = -1;\nfor (let i = messages.length - 1; i >= 0; i--) {\n  if (messages[i].role === 'user') { lastUserIdx = i; break; }\n}\nlet lastAssistantIdx = -1;\nfor (let i = messages.length - 1; i >= 0; i--) {\n  if (messages[i].role === 'assistant') { lastAssistantIdx = i; break; }\n}\n\nconst input = lastUserIdx >= 0 ? messages[lastUserIdx].content : '';\nconst assistantLast = lastAssistantIdx >= 0 ? messages[lastAssistantIdx].content : '';\n\nconst excludeIdx = new Set();\nif (lastUserIdx >= 0) excludeIdx.add(lastUserIdx);\nif (lastAssistantIdx >= 0) excludeIdx.add(lastAssistantIdx);\nconst contextMessages = messages.filter((m, idx) => !excludeIdx.has(idx));\n\nconst override = (triggerData.expected_response || '').trim();\nconst expected_response = override !== '' ? override : assistantLast;\n\nconst case_id = 'eval-' + Date.now();\n\nreturn [{ json: {\n  case_id,\n  input,\n  context_messages: JSON.stringify(contextMessages),\n  context_turns: contextMessages.length,\n  expected_response,\n  prohibited_tools: triggerData.prohibited_tools || '',\n  expected_tools: triggerData.expected_tools || '',\n  source_thread: triggerData.source_thread || '',\n  created_at: new Date().toISOString()\n} }];"
      },
