    {
      "id": "3ec65471-c794-4324-94f6-be7c117869b3",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst total = rows.length;\nconst pass = rows.filter((r) => r.status === 'pass').length;\nconst bad = rows.filter((r) => r.status !== 'pass');\nconst lines = bad.map((r) => `• ${r.case_id} (${r.target}): ${r.status}`);\nconst message = bad.length === 0\n  ? `*Unit suite* ✅ all ${total} checks passed`\n  : `*Unit suite* ❌ ${bad.length}/${total} failed\\n${lines.join('\\n')}`;\nreturn [{ json: { run_id: $('Format Cases').first().json.run_id, total, pass, failed: bad.length, failures: bad, message } }];"
      }
    },
