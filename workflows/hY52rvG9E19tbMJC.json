    {
      "id": "3ec65471-c794-4324-94f6-be7c117869b3",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Aggregate from persisted test_results rows (source of truth) for this run.\nconst runId = $('Format Cases').first().json.run_id;\nlet rows = $input.all().map((i) => i.json).filter((r) => String(r.run_id) === String(runId));\n\n// Deduplicate by case_id, keeping the latest row per case (by run_date, then created_at).\nconst latestByCase = {};\nfor (const r of rows) {\n  const key = r.case_id;\n  const ts = Date.parse(r.run_date || r.created_at || 0) || 0;\n  if (!latestByCase[key] || ts >= latestByCase[key]._ts) {\n    latestByCase[key] = { ...r, _ts: ts };\n  }\n}\nrows = Object.values(latestByCase).map(({ _ts, ...r }) => r);\n\nconst total = rows.length;\nconst pass = rows.filter((r) => r.status === 'pass').length;\nconst bad = rows.filter((r) => r.status !== 'pass');\nconst lines = bad.map((r) => `\\u2022 ${r.case_id} (${r.target}): ${r.status}`);\nconst message = bad.length === 0\n  ? `*Unit suite* \\u2705 all ${total} checks passed`\n  : `*Unit suite* \\u274c ${bad.length}/${total} failed\\n${lines.join('\\n')}`;\nreturn [{ json: { run_id: runId, total, pass, failed: bad.length, failures: bad, message } }];"
      }
    },
