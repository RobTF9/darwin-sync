{
  "id": "kh3IRnj5dckSMAvM",
  "name": "ProjectApprovalFlow",
  "description": "Webhook called by pidgeon-head when a project analysis is approved. Formats the close-out draft from the run's L3 insights and DMs it to the requester in Slack (staging branch sends to Rob).",
  "nodes": [
    {
      "id": "79b35fcc-79d8-45be-a978-827ced4a086d",
      "name": "approve",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        96
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "project-approval",
        "authentication": "headerAuth",
        "options": {}
      },
      "webhookId": "f0c70a66-e662-44b4-b7e1-3658a225fc8a",
      "credentials": {
        "httpHeaderAuth": {
          "id": "tNYo3eGqheixdzIb",
          "name": "PidgeonHead"
        }
      }
    },
    {
      "id": "ad2d4557-e1c5-47bb-9d73-e10bb9c79522",
      "name": "Load Run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        96
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select r.id::text as run_id, r.project_id::text as project_id, r.l3_run_id::text as l3_run_id, r.sessions_analyzed, r.requested_by_slack_user_id, r.approved_by, p.name as project_name from project_analysis_run r join project p on p.id = r.project_id where r.id = $1::uuid",
        "options": {
          "queryReplacement": "={{ $json.body.run_id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "id": "1c3f03ee-6669-4f69-be2e-741aaab473a8",
      "name": "Load Insights",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        448,
        96
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select name, statement, corroboration, sessions_count, questions_count, raters_agreeing, supplementary from project_insight where run_id = $1::uuid order by raters_agreeing desc, case corroboration when 'strong' then 0 when 'moderate' then 1 else 2 end, sessions_count desc",
        "options": {
          "queryReplacement": "={{ $json.l3_run_id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Av2ehn3RdLrlzohO",
          "name": "Supabase Postgres"
        }
      },
      "executeOnce": true
    },
    {
      "id": "25d6d754-a5b8-4ffb-9b12-4867b8791de1",
      "name": "Format Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "jsCode": "const run = $('Load Run').first().json;\nconst insights = $input.all().map(i => i.json);\nconst strong = insights.filter(i => i.corroboration === 'strong').length;\nconst moderate = insights.filter(i => i.corroboration === 'moderate').length;\nconst thin = insights.filter(i => i.corroboration === 'thin').length;\nconst baseUrl = 'https://pidgeonhead.netlify.app';\nconst lines = [];\nlines.push(`\\u{1F4CB} *${run.project_name} — research close-out draft*`);\nlines.push(`${run.sessions_analyzed || insights[0]?.sessions_count || '?'} sessions analysed · ${insights.length} insights (${strong} strong / ${moderate} moderate / ${thin} thin)`);\nlines.push('');\nlines.push('*Key takeaway*');\nlines.push('_Add your key takeaway here..._');\nlines.push('');\nlines.push('*Insights*');\nfor (const ins of insights) {\n  const grade = ins.corroboration + ', ' + ins.sessions_count + ' sessions, ' + ins.questions_count + ' questions' + (ins.raters_agreeing === 2 ? ', both analysts' : '');\n  lines.push(`\\u2022 *${ins.name}* — ${ins.statement} (_${grade}_)`);\n}\nlines.push('');\nlines.push(`Full analysis with playable evidence: ${baseUrl}/projects/${run.project_id}/analysis`);\nreturn [{ json: { text: lines.join('\\n') } }];"
      }
    },
    {
      "id": "92042421-14f3-4200-b3dc-a6d4ebf35067",
      "name": "Staging?",
