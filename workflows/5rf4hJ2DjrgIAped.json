        "jsCode": "const runId = $execution.id;\nconst rows = $input.all();\nconst cases = rows.map((item) => {\n  const r = item.json;\n  const ec = r.eval_config || {};\n  return {\n    json: {\n      run_id: runId,\n      case_id: r.case_id || '',\n      test_case_id: r.id || '',\n      env: 'slack',\n      input: (r.inputs && r.inputs.prompt) || '',\n      context_messages: ec.context_messages || '[]',\n      prohibited_tools: ec.prohibited_tools || '[]',\n      ground_truth: ec.expected_response || '',\n      rubric: '',\n      total_cases: rows.length\n    }\n  };\n});\nreturn cases;"
      },
