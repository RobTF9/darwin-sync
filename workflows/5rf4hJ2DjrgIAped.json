      "parameters": {
        "jsCode": "const runId = $(\"Format Cases\").first().json.run_id;\nconst caseCount = $(\"Format Cases\").all().length;\nlet channel = ''; let threadTs = '';\ntry { channel = $(\"Input\").first().json.slack_channel || ''; threadTs = $(\"Input\").first().json.slack_thread_ts || ''; } catch (e) {}\nconst hasThread = Boolean(channel) && Boolean(threadTs);\nconst message = hasThread\n  ? (\"Dispatched \" + caseCount + \" eval cases. Results will be posted to the thread when complete.\")\n  : (\"Dispatched \" + caseCount + \" eval cases. Results available via read_evals tool.\");\nreturn [{ json: { run_id: runId, case_count: caseCount, status: \"dispatched\", message } }];"
