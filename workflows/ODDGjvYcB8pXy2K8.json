    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH old_plain AS (\n  SELECT id, metadata->>'thread_id' AS thread_id FROM public.plain\n  WHERE (metadata->>'created_at')::timestamptz < now() - interval '3 months'\n),\ndp AS (\n  DELETE FROM public.plain WHERE id IN (SELECT id FROM old_plain) RETURNING id\n),\ndt AS (\n  DELETE FROM public.plain_threads\n  WHERE (data->'updatedAt'->>'iso8601')::timestamptz < now() - interval '3 months'\n  RETURNING thread_id\n),\ndl AS (\n  DELETE FROM public.ingest_ledger\n  WHERE source = 'plain' AND (source_id IN (SELECT thread_id FROM old_plain) OR source_id IN (SELECT thread_id FROM dt))\n  RETURNING 1\n),\ndr AS (\n  DELETE FROM public.resource\n  WHERE path <@ 'plain'\n    AND (\n      (kind = 'directory' AND source_id IS NOT NULL\n        AND (source_id IN (SELECT thread_id FROM dt) OR source_id NOT IN (SELECT thread_id FROM public.plain_threads)))\n      OR (kind = 'plain_thread'\n        AND (source_id::bigint IN (SELECT id FROM old_plain) OR source_id::bigint NOT IN (SELECT id FROM public.plain)))\n    )\n  RETURNING 1\n)\nSELECT (SELECT count(*) FROM dp) AS vectors_deleted,\n       (SELECT count(*) FROM dt) AS threads_deleted,\n       (SELECT count(*) FROM dl) AS ledger_rows_deleted,\n       (SELECT count(*) FROM dr) AS nodes_deleted",
        "options": {}
      },
