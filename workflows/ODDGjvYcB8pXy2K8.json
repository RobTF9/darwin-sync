    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const threads = item.json.data?.threads?.edges || [];\n  \n  for (const { node: thread } of threads) {\n    const messages = (thread.timelineEntries?.edges || [])\n      .filter(({ node: entry }) => entry.llmText)\n      .map(({ node: entry }) => {\n        const ts = entry.timestamp?.iso8601?.slice(0, 16) || '';\n        return ts + ' ' + entry.llmText;\n      });\n\n    if (messages.length === 0) continue;\n\n    const labels = (thread.labels || []).map(l => l.labelType?.name).filter(Boolean);\n\n    const header = [\n      'Thread: ' + (thread.title || 'Untitled'),\n      'Status: ' + thread.status,\n      'Priority: ' + (thread.priority ?? 'UNSET'),\n      labels.length ? 'Labels: ' + labels.join(', ') : null\n    ].filter(Boolean).join(' | ');\n\n    const text = header + '\\n---\\n' + messages.join('\\n');\n\n    results.push({\n      json: {\n        text,\n        thread_id: thread.id,\n        metadata: {\n          thread_id: thread.id,\n          thread_title: thread.title || 'Untitled',\n          status: thread.status,\n          priority: thread.priority ?? 'UNSET',\n          labels,\n          created_at: thread.createdAt?.iso8601,\n          updated_at: thread.updatedAt?.iso8601,\n          message_count: messages.length,\n          source: 'plain'\n        }\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
