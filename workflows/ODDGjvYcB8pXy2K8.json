    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nconst esc = (s) => String(s ?? '').replace(/'/g, \"''\");\n\n// Accept both shapes: split-out edge items ({ node: thread }) from the\n// orchestrator, or full GraphQL page wrappers ({ data: { threads: { edges } } })\n// when run directly.\nconst allThreads = [];\nfor (const item of items) {\n  if (item.json && item.json.node) {\n    allThreads.push(item.json.node);\n  } else {\n    const edges = item.json.data?.threads?.edges || [];\n    for (const e of edges) allThreads.push(e.node);\n  }\n}\n\nfor (const thread of allThreads) {\n  const messages = (thread.timelineEntries?.edges || [])\n    .filter(({ node: entry }) => entry.llmText)\n    .map(({ node: entry }) => {\n      const actor = entry.actor?.user?.fullName || entry.actor?.customer?.fullName || entry.actor?.machineUser?.fullName || '';\n      const ts = entry.timestamp?.iso8601?.slice(0, 16) || '';\n      return (ts + (actor ? ' [' + actor + ']' : '') + ' ' + entry.llmText).trim();\n    });\n\n  if (messages.length === 0) continue;\n\n  const labels = (thread.labels || []).map(l => l.labelType?.name).filter(Boolean);\n  const customerName = thread.customer?.fullName || null;\n  const email = thread.customer?.email?.email || null;\n  const company = email ? email.split('@')[1]?.replace(/\\.(com|co|io|net|org)$/, '') : null;\n\n  const header = [\n    'Thread: ' + (thread.title || 'Untitled'),\n    'Status: ' + thread.status,\n    'Priority: ' + (thread.priority ?? 'UNSET'),\n    customerName ? 'Customer: ' + customerName + (company ? ' (' + company + ')' : '') : null,\n    labels.length ? 'Labels: ' + labels.join(', ') : null\n  ].filter(Boolean).join(' | ');\n\n  const text = header + '\\n---\\n' + messages.join('\\n');\n\n  // One statement, both side effects: upsert the raw thread store AND dedupe\n  // the vector rows for this thread. Passthrough row keeps the item flow 1:1.\n  const sync_sql =\n    \"WITH u AS (INSERT INTO public.plain_threads (thread_id, customer_id, status, priority, data, ingested_at) VALUES ('\" +\n    esc(thread.id) + \"', \" +\n    (thread.customer?.id ? \"'\" + esc(thread.customer.id) + \"'\" : \"null\") + \", '\" +\n    esc(thread.status) + \"', '\" +\n    esc(String(thread.priority ?? 'UNSET')) + \"', '\" +\n    esc(JSON.stringify(thread)) + \"'::jsonb, now()) \" +\n    \"ON CONFLICT (thread_id) DO UPDATE SET customer_id = EXCLUDED.customer_id, status = EXCLUDED.status, priority = EXCLUDED.priority, data = EXCLUDED.data, ingested_at = now() RETURNING 1), \" +\n    \"d AS (DELETE FROM public.plain WHERE metadata->>'thread_id' = '\" + esc(thread.id) + \"' RETURNING 1) \" +\n    \"SELECT 1 AS passthrough;\";\n\n  results.push({\n    json: {\n      text,\n      thread_id: thread.id,\n      sync_sql,\n      metadata: {\n        thread_id: thread.id,\n        thread_title: thread.title || 'Untitled',\n        status: thread.status,\n        priority: thread.priority ?? 'UNSET',\n        customer_name: customerName,\n        company,\n        labels: labels.join(', '),\n        created_at: thread.createdAt?.iso8601,\n        updated_at: thread.updatedAt?.iso8601,\n        message_count: messages.length,\n        source: 'plain'\n      }\n    }\n  });\n}\n\nreturn results;"
      },
