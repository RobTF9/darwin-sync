    {
      "id": "562d94f4-5f96-4cf7-90bf-74305dcc670a",
      "name": "Zip And Build SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ],
      "parameters": {
        "jsCode": "const ids = $('Build Batch').first().json.ids;\nconst data = ($json.data || []).slice().sort((a, b) => a.index - b.index);\nconst values = ids.map((id, idx) => {\n  const emb = data[idx] && Array.isArray(data[idx].embedding) ? data[idx].embedding : null;\n  if (!emb) return null;\n  const vec = emb.map(x => Number(x.toFixed(6))).join(',');\n  return `(${id}, '[${vec}]'::vector(3072))`;\n}).filter(Boolean);\nif (!values.length) return [{ json: { sql: 'SELECT 1;', count: 0 } }];\nconst sql = `UPDATE public.nps_open_text_insights AS t SET embedding = v.emb FROM (VALUES ${values.join(',')}) AS v(id, emb) WHERE t.id = v.id;`;\nreturn [{ json: { sql, count: values.length } }];"
      }
    },
