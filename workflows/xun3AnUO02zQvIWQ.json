    {
      "id": "20da879c-8f03-447e-ad51-1c02b28e7ea2",
      "name": "Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Settings for the real-data test. Only events of this one Calendly event type are read,\n// so invitee data of other (real) sessions is never fetched.\nreturn [{\n  json: {\n    demoEventName: 'Session follow-up demo',\n    minStart: $now.minus({ hours: 6 }).toUTC().toISO(),\n    maxStart: $now.plus({ days: 14 }).toUTC().toISO(),\n  },\n}];\n"
      }
    },
