        }
      }
    },
    {
      "id": "4231f9bc-8c9d-4e95-b5b8-dacf852ee3fb",
      "name": "Keep Demo Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Keeps only the events of the demo event type (by name). Other events are dropped before any invitee lookup.\nconst name = $('Settings').first().json.demoEventName;\nconst events = $input.first().json.collection || [];\nreturn events.filter((e) => e.name === name).map((e) => ({ json: { event: e } }));\n"
      }
    },
    {
      "id": "337866b5-083b-49fc-aabd-95c03a75acb3",
      "name": "Get Invitees",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.event.uri }}/invitees",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "calendlyApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
