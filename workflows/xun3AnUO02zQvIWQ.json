    },
    {
      "id": "58644e6a-a4e8-4d35-8ddb-f5cdc4e352aa",
      "name": "Build Webhook Bodies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Builds one Calendly webhook body per invitee, in the same shape as the Calendly Trigger output,\n// so Darwin Sessions Ingest (Calendly) gets exactly what a real webhook would send.\n// Only aniol.moner+...@n8n.io invitees pass (the ingest has the same guard).\nconst events = $('Keep Demo Events').all();\nconst allowed = /^aniol\\.moner\\+[^@]+@n8n\\.io$/;\nconst created = [];\nconst canceled = [];\n$input.all().forEach((item, i) => {\n  const ev = events[i].json.event;\n  for (const inv of item.json.collection || []) {\n    if (!allowed.test((inv.email || '').toLowerCase())) continue;\n    const isCanceled = inv.status === 'canceled';\n    const body = {\n      _label: `${inv.name} | ${ev.start_time} | ${isCanceled ? 'canceled' : 'created'}`,\n      event: isCanceled ? 'invitee.canceled' : 'invitee.created',\n      payload: { ...inv, scheduled_event: ev },\n    };\n    (isCanceled ? canceled : created).push({ json: body });\n  }\n});\n// Creates first, then cancels. The ingest gives the same result in any order.\nreturn [...created, ...canceled];\n"
      }
    },
    {
      "id": "520c8e16-8666-44a4-9547-7fdacd0360ed",
      "name": "Send To Sessions Ingest",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        1568,
        0
      ],
