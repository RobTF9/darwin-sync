      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = $input.first().json;\nconst nodes = (resp && resp.data && resp.data.workflowStates && resp.data.workflowStates.nodes) || [];\nconst rows = nodes.map(s => ({\n  stateName: s.name,\n  stateId: s.id,\n  stateType: s.type,\n  teamName: (s.team && s.team.name) || '',\n  teamId: (s.team && s.team.id) || ''\n}));\nrows.sort((a, b) => (a.teamName || '').localeCompare(b.teamName || '') || (a.stateType || '').localeCompare(b.stateType || ''));\nreturn rows.map(r => ({ json: r }));"
      }
    }
