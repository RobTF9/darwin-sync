      "parameters": {
        "jsCode": "// DWN-39: daily heartbeat. Post one message if any non-session\n// ingestion workflow ran in the last 24 hours.\nconst workflows = [\n  { name: 'SlackIngestion', node: \"Execs: SlackIngestion\" },\n  { name: 'ForumIngestion', node: \"Execs: ForumIngestion\" },\n  { name: 'PlainIngestion', node: \"Execs: PlainIngestion\" },\n  { name: 'GongIngestion', node: \"Execs: GongIngestion\" },\n];\nconst cutoff = Date.now() - 24 * 60 * 60 * 1000;\nconst lines = [];\nfor (const w of workflows) {\n  let runs = 0;\n  try {\n    const items = $(w.node).all();\n    runs = items.filter((i) => {\n      const ts = i.json.startedAt || (i.json.data && i.json.data.startedAt);\n      return ts && new Date(ts).getTime() >= cutoff;\n    }).length;\n  } catch (e) {\n    runs = 0;\n  }\n  if (runs > 0) lines.push(w.name + ': ' + runs + ' run(s)');\n}\nif (lines.length === 0) return [];\nreturn [{ json: { text: lines.join('\\n') } }];"
      }
    },
