{
  "id": "rSNQtJm4MSYsYUku",
  "name": "FanOutDispatcher",
  "description": "Detached wave dispatcher for agent fan-out: loads the run's pending fan_out_item rows and fires FanOutAgentWorker executions in waves of 6 every 30s. Caps concurrent child agent sessions (~12) so the instance never repeats the 37-way memory crush.",
  "nodes": [
    {
      "id": "014f42ca-d2a7-4758-832e-0607c4a97189",
      "name": "Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        80
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "run_id"
            }
          ]
        }
      }
    },
    {
      "id": "bf54c2e0-1353-4a9f-9c0c-67e67cdad7cc",
      "name": "Load Pending Rows",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        80
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "fan_out_item",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "run_id",
              "condition": "eq",
              "keyValue": "={{ $('Input').first().json.run_id }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "gBIPPKjo4dshypxE",
          "name": "Supabase API"
        }
      }
    },
    {
      "id": "2c5529be-58b4-4d2c-b0e7-4abe62a52c2e",
      "name": "Batch",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        448,
        80
      ],
      "parameters": {
        "batchSize": 6,
        "options": {}
      }
    },
    {
      "id": "c178c92b-e5f3-49c9-96a1-9f4a2936ce33",
      "name": "Call Worker",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "dzhUHS2Mjvsjv1qs",
          "cachedResultName": "FanOutAgentWorker"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "row_id": "={{ $json.id }}",
            "item": "={{ typeof $json.item === 'string' ? $json.item : JSON.stringify($json.item) }}",
            "instruction": "={{ $json.instruction }}",
            "context": "={{ $json.context }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "row_id",
              "displayName": "row_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "item",
              "displayName": "item",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "instruction",
              "displayName": "instruction",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "context",
              "displayName": "context",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    },
    {
      "id": "8cd93f2d-03ee-4465-9d9c-ccb1cc549528",
      "name": "Pace",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        896,
        80
      ],
      "parameters": {
        "amount": 30
      },
      "webhookId": "55337a49-cefc-44c2-b06a-57daceade60e"
    }
  ],
  "connections": {
    "Input": {
      "main": [
        [
          {
            "node": "Load Pending Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Pending Rows": {
      "main": [
        [
          {
            "node": "Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Batch": {
      "main": [
        [],
        [
          {
            "node": "Call Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Worker": {
      "main": [
        [
          {
            "node": "Pace",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pace": {
      "main": [
        [
          {
            "node": "Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "triggerCount": 0,
