    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const BOT_USER_ID = \"65049f30-62b1-4061-88a4-f02c572a91ca\";\nconst p = $json;\nconst data = p.data || p;\nconst actor = p.actor || {};\nconst topType = p.type || '';\n\nfunction detectMention(body, botUserId) {\n  if (!body || !botUserId) return false;\n  const re = new RegExp('user:' + botUserId.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '\\\\)', 'i');\n  return re.test(body);\n}\n\nconst isComment = topType === 'Comment' || !!data.body || !!data.issueId;\n\nif (isComment) {\n  const commentId = data.id || '';\n  const issueId = data.issueId || (data.issue && data.issue.id) || '';\n  const commentBody = data.body || '';\n  const commentUserId = data.userId || (data.user && data.user.id) || actor.id || '';\n  const issueIdentifier = (data.issue && data.issue.identifier) || '';\n  const issueTitle = (data.issue && data.issue.title) || '';\n  const issueUrl = (data.issue && data.issue.url) || '';\n\n  if (commentUserId === BOT_USER_ID) {\n    return { json: { type: 'comment', action: 'drop', reason: 'bot_self_comment', issueId, commentId, commentBody, commentUserId, issueIdentifier, issueTitle, issueUrl } };\n  }\n\n  if (!detectMention(commentBody, BOT_USER_ID)) {\n    return { json: { type: 'comment', action: 'drop', reason: 'no_mention', issueId, commentId, commentBody, commentUserId, issueIdentifier, issueTitle, issueUrl } };\n  }\n\n  const stripped = commentBody.replace(/@\\[.*?\\]\\(user:.*?\\)\\s*/i, '').trim().toLowerCase();\n  if (stripped === 'reset') {\n    return { json: { type: 'comment', action: 'reset', reason: 'reset_command', issueId, commentId, commentBody, commentUserId, issueIdentifier, issueTitle, issueUrl } };\n  }\n  if (stripped === 'halt') {\n    return { json: { type: 'comment', action: 'halt', reason: 'halt_command', issueId, commentId, commentBody, commentUserId, issueIdentifier, issueTitle, issueUrl } };\n  }\n\n  return { json: { type: 'comment', action: 'dispatch', reason: 'mentioned_comment', issueId, commentId, commentBody, commentUserId, issueIdentifier, issueTitle, issueUrl } };\n}\n\nconst issueId = data.id || '';\nconst ticketIdentifier = data.identifier || '';\nconst title = data.title || '';\nconst description = data.description || '';\nconst url = data.url || (ticketIdentifier ? 'https://linear.app/n8n/issue/' + ticketIdentifier : '');\nconst stateName = (data.state && data.state.name || '').toLowerCase().trim();\nconst stateType = (data.state && data.state.type) || '';\nconst isTodo = stateName === 'todo' || stateType === 'unstarted';\n\nif (!isTodo) {\n  return { json: { type: 'issue', action: 'drop', reason: 'not_todo', issueId, ticketIdentifier, title, stateName, stateType } };\n}\n\nreturn { json: { type: 'issue', action: 'dispatch', reason: 'moved_to_todo', issueId, ticketIdentifier, title, description, url, stateName, stateType } };"
      },
