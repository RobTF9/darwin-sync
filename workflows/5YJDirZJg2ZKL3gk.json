    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const classified = $('Classify Event').item.json;\nconst stateResult = $json;\nconst buildState = stateResult.state || stateResult || { status: 'IDLE', halted: false };\nif (classified.action === 'drop' || classified.action === 'reset' || classified.action === 'halt') {\n  return { json: classified };\n}\nconst status = buildState.status || 'IDLE';\nconst halted = buildState.halted === true;\nif (classified.type === 'comment') {\n  if (halted) {\n    return { json: Object.assign({}, classified, { action: 'drop', reason: 'halted' }) };\n  }\n  if (status === 'RUNNING') {\n    return { json: Object.assign({}, classified, { action: 'queue', reason: 'running' }) };\n  }\n}\nreturn { json: classified };"
      },
